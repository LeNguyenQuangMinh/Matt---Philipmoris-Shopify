{% assign bl_stts = block.settings %}
{%- capture cart_product_inner_class -%}
  cart__products-inner cart__products
  {% if bl_stts.extend_summary == false and bl_stts.border_radius > 0 -%}
    has-border-radius
  {%- endif -%}
{%- endcapture -%}

{% if bl_stts.extend_summary %}
  <div
    class="section-background {% if bl_stts.inherit_color_scheme == false %} color-scheme-custom{% endif %}"
    {% if bl_stts.inherit_color_scheme == false %}style="{% render 'color-scheme-style', settings: bl_stts %}"{% endif %}
  ></div>
{% endif %}
<div
  id="main-cart-products"
  class="cart__products-container border-style{% if bl_stts.extend_summary == true %} cart__container--extend{% if bl_stts.inherit_color_scheme == false %} color-scheme-custom{% endif %}{% endif %}{% if bl_stts.border_radius > 0 %} has-border-radius{% endif %}{% if cart.empty? %} is-empty{% endif %}"
  data-id="{{ section.id }}"
  style="
    {% render 'border-override', settings: bl_stts %}
    {% if bl_stts.inherit_color_scheme == false %}
      {% render 'color-scheme-style', settings: bl_stts %}
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  <div class="{{ cart_product_inner_class }}">
    {% content_for 'block', id: 'cart-product', type: '_cart-product' %}
    {%- unless cart.empty? -%}
      {% content_for 'block', id: 'cart-gift-card', type: '_cart-gift-card' %}
      {% content_for 'block', id: 'cart-note', type: '_cart-note' %}
      {% content_for 'blocks' %}
    {%- endunless -%}
  </div>
</div>

<script>
  (function() {
    let addonSyncBusy = false;
    let syncTimer = null;

    // Only listen for cart changes from the cart component (remove/qty change),
    // not from product-form add-to-cart
    document.addEventListener('cart:updated', function(event) {
      // Skip events dispatched by our own sync to avoid infinite loop
      if (event?.detail?._addonSyncSource) return;
      // Skip if busy
      if (addonSyncBusy) return;
      // Debounce: wait 800ms to ensure addon product fetch (from embossing block) has completed
      clearTimeout(syncTimer);
      syncTimer = setTimeout(function() { syncAddonItems(); }, 800);
    });

    async function syncAddonItems() {
      if (addonSyncBusy) return;
      addonSyncBusy = true;

      try {
        const cartUrl = (window.routes?.cart_url || '/cart') + '.js';
        const res = await fetch(cartUrl, { cache: 'no-store' });
        if (!res.ok) return;
        const cart = await res.json();
        if (!cart || !cart.items || cart.items.length === 0) return;

        const mainItems = [];
        const addonItems = [];

        cart.items.forEach(function(item) {
          if (item.properties && item.properties._is_addon === 'true') {
            addonItems.push(item);
          } else {
            mainItems.push(item);
          }
        });

        // No addon items in cart — nothing to sync
        if (addonItems.length === 0) return;

        // Build a map: variant_id → total quantity of main (non-addon) items
        const mainVariantQty = {};
        mainItems.forEach(function(item) {
          const vid = String(item.variant_id);
          mainVariantQty[vid] = (mainVariantQty[vid] || 0) + item.quantity;
        });

        const updates = {};
        let needsUpdate = false;

        addonItems.forEach(function(addon) {
          const parentVid = addon.properties?._main_variant_id;
          if (!parentVid) return;

          const parentQty = mainVariantQty[String(parentVid)];

          if (!parentQty || parentQty <= 0) {
            // Parent product was removed — remove addon too
            updates[addon.key] = 0;
            needsUpdate = true;
          } else if (addon.quantity !== parentQty) {
            // Parent quantity changed — sync addon quantity
            updates[addon.key] = parentQty;
            needsUpdate = true;
          }
        });

        if (!needsUpdate) return;

        // Apply updates via /cart/update.js
        const updateUrl = (window.routes?.cart_update_url || '/cart/update') + '.js';
        const updateRes = await fetch(updateUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ updates: updates })
        });
        if (!updateRes.ok) return;
        const updatedCart = await updateRes.json();

        // Update cart count in header
        if (updatedCart.item_count !== undefined) {
          document.querySelectorAll('[data-cart-count]').forEach(function(el) {
            el.textContent = updatedCart.item_count;
          });
        }

        if (typeof window.updateCartEmptyStateVisibility === 'function' && updatedCart.item_count !== undefined) {
          window.updateCartEmptyStateVisibility(updatedCart.item_count);
        }

        // Re-render cart sections by fetching fresh section HTML
        const cartComponent = document.querySelector('cart-items-component') || document.querySelector('cart-drawer-items');
        if (cartComponent && cartComponent.dataset.sectionId) {
          const sectionId = cartComponent.dataset.sectionId;
          const sectionUrl = new URL(window.location.href);
          sectionUrl.searchParams.set('section_id', sectionId);
          const sectionRes = await fetch(sectionUrl.toString(), { cache: 'no-store' });
          if (sectionRes.ok) {
            const sectionHtml = await sectionRes.text();
            if (typeof cartComponent.updateSections === 'function') {
              const sections = {};
              sections[sectionId] = sectionHtml;
              cartComponent.updateSections(sections, updatedCart);
            }
          }
        }

        // Dispatch cart:updated with a flag so we don't re-trigger ourselves
        document.dispatchEvent(new CustomEvent('cart:updated', {
          detail: Object.assign({}, updatedCart, { _addonSyncSource: true })
        }));

      } catch (err) {
        console.warn('Addon sync error:', err);
      } finally {
        addonSyncBusy = false;
      }
    }
  })();
</script>

{% schema %}
{
  "name": "t:names.cart_items",
  "tag": null,
  "blocks": [
    { "type": "@app" },
    { "type": "@theme" },
    { "type": "spacer" },
    { "type": "_divider" },
    { "type": "image-with-content" }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color",
      "id": "scheme_background",
      "label": "t:settings.background",
      "default": "#FFFFFF",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color_background",
      "id": "scheme_background_gradient",
      "label": "t:settings.background_gradient",
      "info": "t:info.background_gradient_info",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color",
      "id": "scheme_foreground_heading",
      "label": "t:settings.headings",
      "default": "#000000",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color",
      "id": "scheme_foreground",
      "label": "t:settings.text",
      "default": "#000000",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color",
      "id": "scheme_primary",
      "label": "t:settings.primary_color",
      "default": "#000F9F",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color",
      "id": "scheme_primary_hover",
      "label": "t:settings.primary_hover_color",
      "default": "#000000",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color",
      "id": "scheme_border",
      "label": "t:settings.borders",
      "default": "#E6E6E6",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "color",
      "id": "scheme_shadow",
      "label": "t:settings.shadow_color",
      "default": "#000000",
      "alpha": true,
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.cart_items"
    }
  ]
}
{% endschema %}
