{% liquid
  assign product = closest.product
  assign title = block.settings.title | default: 'Size Guide'
  assign view_content = block.settings.view_content
  assign accordion_icon = block.settings.accordion_icon
  assign accordion_border_style = block.settings.accordion_border_style
  assign accordion_border_color = block.settings.accordion_border_color
%}

{%- capture icon -%}
  {% if accordion_icon == 'plus' %}
    {{- 'icon-plus.svg' | inline_asset_content -}}
  {% elsif accordion_icon == 'right-arrow' %}
    {{- 'icon-right-arrow.svg' | inline_asset_content -}}
  {% elsif accordion_icon == 'caret' %}
    {{- 'icon-caret.svg' | inline_asset_content -}}
  {% endif %}
{%- endcapture -%}

{%- capture tab_title -%}
  {% liquid
    assign element = 'side-drawer-opener'
    if view_content == 'default'
      assign element = 'div'
    endif
  %}

  <{{ element }} {% if view_content == 'popup' %}data-side-drawer="#PopupModal-{{ section.id }}"{% else %}data-side-drawer="#Global-Drawer"{% endif %} class="toggle-title{% if view_content == 'default' %} isCheckingOpenDefault {% endif %}" data-view-content="{{ view_content }}">
    <button class="toggle-link cursor-pointer">
      <span class="text">Tab Title</span>
      <span class="svg-wrapper icon-caret-wrapper">{{- icon -}}</span>
    </button>
  </{{ element }}>
{%- endcapture -%}

{% liquid
  assign tab_content_output = ''
  assign has_size_chart = false
  assign is_image = false
  assign is_image_url = false
  assign size_chart_image = nil
  assign size_chart_image_url = nil
  assign size_chart_details = nil
  assign guide = nil

  # 1. Direct Product Metafield Check (custom.size_guide or custom.size_chart)
  assign direct_guide = product.metafields.custom.size_guide.value | default: product.metafields.custom.size_guide | default: product.metafields.custom.size_chart.value | default: product.metafields.custom.size_chart

  if direct_guide != blank
    if direct_guide.size_guide_image != blank or direct_guide.image != blank or direct_guide.size_chart_image != blank or direct_guide.size_chart != blank or direct_guide.size_guide_file != blank or direct_guide.file != blank or direct_guide.photo != blank or direct_guide.picture != blank or direct_guide.content != blank or direct_guide.details != blank or direct_guide.description != blank
      assign guide = direct_guide
    elsif direct_guide.type == 'file_reference' or direct_guide.width != blank or direct_guide.aspect_ratio != blank or direct_guide.src != blank
      assign has_size_chart = true
      assign is_image = true
      assign size_chart_image = direct_guide
    else
      capture direct_str
        echo direct_guide
      endcapture
      assign direct_str_clean = direct_str | strip
      if direct_str_clean contains 'http' or direct_str_clean contains '//cdn.shopify' or direct_str_clean contains '/files/' or direct_str_clean contains '.jpg' or direct_str_clean contains '.png' or direct_str_clean contains '.webp'
        assign has_size_chart = true
        assign is_image_url = true
        assign size_chart_image_url = direct_str_clean
      elsif direct_str_clean != blank
        assign has_size_chart = true
        assign size_chart_details = direct_guide
      endif
    endif
  endif

  # 2. Metaobject Auto-Detection Logic if no direct guide assigned
  if has_size_chart == false and guide == blank
    assign raw_gender = product.metafields.custom.gender.value | default: product.metafields.custom.gender | default: product.metafields.facts.gender.value | default: product.metafields.facts.gender
    if raw_gender.first != blank
      assign raw_gender = raw_gender.first
    endif

    if raw_gender.label != blank
      assign gender_str = raw_gender.label
    elsif raw_gender.name != blank
      assign gender_str = raw_gender.name
    elsif raw_gender.title != blank
      assign gender_str = raw_gender.title
    elsif raw_gender.value != blank
      assign gender_str = raw_gender.value
    else
      assign gender_str = raw_gender
    endif

    assign g = gender_str | default: '' | handleize
    assign v = product.vendor | handleize
    assign t = product.type | handleize

    assign genders_to_check = ''
    if g == 'm' or g == 'men' or g == 'mens' or g == 'male'
      assign genders_to_check = 'mens,male,men,m' | split: ','
    elsif g == 'f' or g == 'w' or g == 'women' or g == 'womens' or g == 'female'
      assign genders_to_check = 'female,womens,women,f' | split: ','
    elsif g == 'u' or g == 'unisex'
      assign genders_to_check = 'unisex,u' | split: ','
    elsif g != blank
      assign genders_to_check = g | split: ','
    endif

    assign t_alt = t
    if t != blank
      assign t_size = t.size
      assign last_char = t | slice: -1, 1
      if last_char == 's' and t_size > 1
        assign t_len = t_size | minus: 1
        assign t_alt = t | slice: 0, t_len
      else
        assign t_alt = t | append: 's'
      endif
    endif

    assign raw_types = ''
    if t != blank
      assign raw_types = raw_types | append: t | append: ','
      if t_alt != blank and t_alt != t
        assign raw_types = raw_types | append: t_alt | append: ','
      endif
    endif

    # Collect tags
    for tag in product.tags
      assign tag_h = tag | handleize
      if tag_h != blank and tag_h != 'male' and tag_h != 'female' and tag_h != 'mens' and tag_h != 'womens' and tag_h != 'unisex' and tag_h != v
        assign raw_types = raw_types | append: tag_h | append: ','
      endif
    endfor

    # Collect collections
    for col in product.collections
      assign col_h = col.handle
      if col_h != blank and col_h != 'all' and col_h != v
        assign raw_types = raw_types | append: col_h | append: ','
      endif
    endfor

    # Semantic mapping for broader categories (e.g. Ankle Boot -> Footwear)
    assign p_tags_str = product.tags | join: ' ' | downcase
    assign p_cols_str = product.collections | map: 'title' | join: ' ' | downcase
    assign combined_info = t | append: ' ' | append: p_tags_str | append: ' ' | append: p_cols_str
    if combined_info contains 'boot' or combined_info contains 'shoe' or combined_info contains 'footwear' or combined_info contains 'sneaker' or combined_info contains 'wellington' or combined_info contains 'slipper' or combined_info contains 'derby' or combined_info contains 'brogue' or combined_info contains 'chelsea' or combined_info contains 'loaf' or combined_info contains 'trainer'
      assign raw_types = raw_types | append: 'footwear,shoes,boots,ankle-boots,chelsea-boots,'
    endif
    if combined_info contains 'jacket' or combined_info contains 'coat' or combined_info contains 'gilet' or combined_info contains 'waistcoat' or combined_info contains 'parka' or combined_info contains 'fleece'
      assign raw_types = raw_types | append: 'clothing,jackets,coats,outerwear,'
    endif
    if combined_info contains 'knitwear' or combined_info contains 'jumper' or combined_info contains 'sweater' or combined_info contains 'cardigan'
      assign raw_types = raw_types | append: 'clothing,knitwear,jumpers,'
    endif
    if combined_info contains 'shirt' or combined_info contains 'polo' or combined_info contains 't-shirt' or combined_info contains 'tee' or combined_info contains 'top'
      assign raw_types = raw_types | append: 'clothing,shirts,tops,t-shirts,'
    endif
    if combined_info contains 'trouser' or combined_info contains 'jean' or combined_info contains 'pant' or combined_info contains 'short'
      assign raw_types = raw_types | append: 'clothing,trousers,jeans,shorts,bottoms,'
    endif
    if combined_info contains 'hat' or combined_info contains 'cap' or combined_info contains 'beanie'
      assign raw_types = raw_types | append: 'accessories,hats,caps,'
    endif
    if combined_info contains 'glove' or combined_info contains 'mitten'
      assign raw_types = raw_types | append: 'accessories,gloves,'
    endif
    if combined_info contains 'belt'
      assign raw_types = raw_types | append: 'accessories,belts,'
    endif
    if combined_info contains 'sock'
      assign raw_types = raw_types | append: 'accessories,socks,'
    endif

    assign types_to_check = raw_types | split: ',' | compact | uniq

    # 1. Try gender + vendor + type combinations
    if guide == blank and genders_to_check != blank and v != blank and types_to_check != blank
      for gen in genders_to_check
        if guide != blank
          break
        endif
        for typ in types_to_check
          assign k = gen | append: '-' | append: v | append: '-' | append: typ
          assign guide = shop.metaobjects.size_guide[k] | default: shop.metaobjects['size-guide'][k] | default: shop.metaobjects.size_chart[k] | default: shop.metaobjects.size_guides[k]
          if guide == blank
            assign k_sizes = k | append: '-sizes'
            assign guide = shop.metaobjects.size_guide[k_sizes] | default: shop.metaobjects['size-guide'][k_sizes] | default: shop.metaobjects.size_chart[k_sizes] | default: shop.metaobjects.size_guides[k_sizes]
          endif
          if guide == blank
            assign k_size = k | append: '-size'
            assign guide = shop.metaobjects.size_guide[k_size] | default: shop.metaobjects['size-guide'][k_size] | default: shop.metaobjects.size_chart[k_size] | default: shop.metaobjects.size_guides[k_size]
          endif
          if guide != blank
            break
          endif
        endfor
      endfor
    endif

    # 2. Try vendor + type combinations
    if guide == blank and v != blank and types_to_check != blank
      for typ in types_to_check
        assign k = v | append: '-' | append: typ
        assign guide = shop.metaobjects.size_guide[k] | default: shop.metaobjects['size-guide'][k] | default: shop.metaobjects.size_chart[k] | default: shop.metaobjects.size_guides[k]
        if guide == blank
          assign k_sizes = k | append: '-sizes'
          assign guide = shop.metaobjects.size_guide[k_sizes] | default: shop.metaobjects['size-guide'][k_sizes] | default: shop.metaobjects.size_chart[k_sizes] | default: shop.metaobjects.size_guides[k_sizes]
        endif
        if guide != blank
          break
        endif
      endfor
    endif

    # 3. Try gender + type combinations
    if guide == blank and genders_to_check != blank and types_to_check != blank
      for gen in genders_to_check
        if guide != blank
          break
        endif
        for typ in types_to_check
          assign k = gen | append: '-' | append: typ
          assign guide = shop.metaobjects.size_guide[k] | default: shop.metaobjects['size-guide'][k] | default: shop.metaobjects.size_chart[k] | default: shop.metaobjects.size_guides[k]
          if guide == blank
            assign k_sizes = k | append: '-sizes'
            assign guide = shop.metaobjects.size_guide[k_sizes] | default: shop.metaobjects['size-guide'][k_sizes] | default: shop.metaobjects.size_chart[k_sizes] | default: shop.metaobjects.size_guides[k_sizes]
          endif
          if guide != blank
            break
          endif
        endfor
      endfor
    endif

    # 4. Try type combinations
    if guide == blank and types_to_check != blank
      for typ in types_to_check
        assign guide = shop.metaobjects.size_guide[typ] | default: shop.metaobjects['size-guide'][typ] | default: shop.metaobjects.size_chart[typ] | default: shop.metaobjects.size_guides[typ]
        if guide == blank
          assign k_sizes = typ | append: '-sizes'
          assign guide = shop.metaobjects.size_guide[k_sizes] | default: shop.metaobjects['size-guide'][k_sizes] | default: shop.metaobjects.size_chart[k_sizes] | default: shop.metaobjects.size_guides[k_sizes]
        endif
        if guide != blank
          break
        endif
      endfor
    endif

    # 5. Fallback: Search in shop.metaobjects by attributes matching
    if guide == blank
      assign meta_list = shop.metaobjects.size_guide.values | default: shop.metaobjects['size-guide'].values | default: shop.metaobjects.size_chart.values | default: shop.metaobjects.size_guides.values
      if meta_list != blank
        for meta_item in meta_list
          # Check vendor match
          assign meta_v = meta_item.vendor | default: meta_item.brand | default: meta_item.manufacturer | handleize
          assign vendor_match = false
          if meta_v == blank or meta_v == v
            assign vendor_match = true
          endif

          # Check gender match
          assign meta_g = meta_item.gender | default: meta_item.target_gender | handleize
          assign gender_match = false
          if meta_g == blank
            assign gender_match = true
          elsif genders_to_check != blank
            for gen in genders_to_check
              if gen == meta_g
                assign gender_match = true
                break
              endif
            endfor
          endif

          # Check type match
          assign meta_t = meta_item.product_type | default: meta_item.type | default: meta_item.category | handleize
          assign type_match = false
          if meta_t == blank
            assign type_match = true
          else
            for typ in types_to_check
              if typ == meta_t
                assign type_match = true
                break
              endif
            endfor
          endif

          if vendor_match and gender_match and type_match
            assign guide = meta_item
            break
          endif
        endfor
      endif
    endif
  endif

  # 3. Extract content from Metaobject entry (guide) if found
  if guide != blank
    assign has_size_chart = true
    assign meta_img = guide.size_guide_image.value | default: guide.image.value | default: guide.size_guide_image | default: guide.image | default: guide.size_chart_image.value | default: guide.size_chart_image | default: guide.size_chart.value | default: guide.size_chart | default: guide.size_guide_file.value | default: guide.size_guide_file | default: guide.size_chart_file.value | default: guide.size_chart_file | default: guide.file.value | default: guide.file | default: guide.photo.value | default: guide.photo | default: guide.picture.value | default: guide.picture

    if meta_img != blank
      assign is_image = true
      assign size_chart_image = meta_img
    else
      assign meta_text = guide.content.value | default: guide.content | default: guide.details.value | default: guide.details | default: guide.description.value | default: guide.description | default: guide.text.value | default: guide.text | default: guide.html.value | default: guide.html
      if meta_text != blank
        assign size_chart_details = meta_text
      endif
    endif
  endif

  # 4. Generate Tab Content Output HTML
  if has_size_chart
    capture tab_content_output
      if is_image and size_chart_image != blank
        echo '<div class="tab-media-image center flex justify-center w-full">'
        echo size_chart_image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'tab-image w-full h-auto object-contain m-auto', widths: '375, 550, 750, 1100, 1400', alt: title
        echo '</div>'
      elsif is_image_url
        echo '<div class="tab-media-image center flex justify-center w-full">'
        echo '<img src="' | append: size_chart_image_url | append: '" alt="' | append: title | append: '" loading="lazy" class="tab-image w-full h-auto object-contain m-auto" />'
        echo '</div>'
      elsif size_chart_details != blank
        echo '<div class="rte w-full">'
        echo size_chart_details
        echo '</div>'
      endif
    endcapture
  endif
%}

{% if tab_content_output != blank %}
  <div class="tab-content{% if accordion_border_style != 'none' %} border-{{ accordion_border_style }}{% endif %}" style="--accordion-border-color: {{ accordion_border_color }};">
    {{ tab_title | replace: 'Tab Title', title }}
    <div class="toggle-content">
      {{ tab_content_output }}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Size Guide Tab",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "Size Guide"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open tab by default",
      "default": false,
      "info": "This setting only works if the tabs design is set to accordion with default view"
    },
    {
      "type": "select",
      "id": "view_content",
      "label": "t:settings.view_content",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "sidebar",
          "label": "t:options.sidebar"
        },
        {
          "value": "popup",
          "label": "t:options.popup"
        }
      ],
      "default": "sidebar"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "accordion_icon",
      "label": "t:settings.icon",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "caret", "label": "t:options.caret" },
        { "value": "plus", "label": "t:options.plus" },
        { "value": "right-arrow", "label": "t:options.right_arrow" }
      ],
      "default": "caret"
    },
    {
      "type": "select",
      "id": "accordion_border_style",
      "label": "t:settings.border_style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "top",
          "label": "t:options.top"
        },
        {
          "value": "bottom",
          "label": "t:options.bottom"
        },
        {
          "value": "top-bottom",
          "label": "t:options.top_bottom"
        },
        {
          "value": "full",
          "label": "t:options.full"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "color",
      "id": "accordion_border_color",
      "label": "t:settings.border_color",
      "default": "#d3d3d3",
      "visible_if": "{{ block.settings.accordion_border_style != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "Size Guide Tab",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
