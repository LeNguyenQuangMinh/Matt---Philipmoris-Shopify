{% liquid
  assign bl_stts = block.settings

  capture text_block_classes
    if bl_stts.type_preset == 'custom'
      echo ' custom-typography '
      if bl_stts.font_size != ''
        echo ' custom-font-size '
      endif
    endif
    if bl_stts.color != ''
      echo ' custom-color '
    endif
  endcapture

  assign has_size_chart = false
  assign size_chart_type = bl_stts.size_chart_type
  assign is_image = false
  assign is_image_url = false
  assign size_chart_image = nil
  assign size_chart_image_url = nil
  assign size_chart_details = nil

  # 1. Direct Product Metafield Check (custom.size_guide or custom.size_chart)
  assign direct_guide = product.metafields.custom.size_guide.value | default: product.metafields.custom.size_guide | default: product.metafields.custom.size_chart.value | default: product.metafields.custom.size_chart
  
  if direct_guide != blank
    if direct_guide.size_guide_image != blank or direct_guide.image != blank or direct_guide.size_chart_image != blank or direct_guide.size_chart != blank or direct_guide.size_guide_file != blank or direct_guide.file != blank or direct_guide.photo != blank or direct_guide.picture != blank or direct_guide.content != blank or direct_guide.details != blank or direct_guide.description != blank
      assign guide = direct_guide
    elsif direct_guide.type == 'file_reference' or direct_guide.width != blank or direct_guide.aspect_ratio != blank or direct_guide.src != blank
      assign has_size_chart = true
      assign is_image = true
      assign size_chart_image = direct_guide
    else
      capture direct_str
        echo direct_guide
      endcapture
      assign direct_str_clean = direct_str | strip
      if direct_str_clean contains 'http' or direct_str_clean contains '//cdn.shopify' or direct_str_clean contains '/files/' or direct_str_clean contains '.jpg' or direct_str_clean contains '.png' or direct_str_clean contains '.webp'
        assign has_size_chart = true
        assign is_image_url = true
        assign size_chart_image_url = direct_str_clean
      elsif direct_str_clean != blank
        assign has_size_chart = true
        assign size_chart_details = direct_guide
      endif
    endif
  endif

  # 2. Metaobject Auto-Detection Logic based on Product Attributes if no direct guide
  if has_size_chart == false and guide == blank
    assign raw_gender = product.metafields.custom.gender.value | default: product.metafields.custom.gender | default: product.metafields.facts.gender.value | default: product.metafields.facts.gender
    if raw_gender.first != blank
      assign raw_gender = raw_gender.first
    endif
    
    if raw_gender.label != blank
      assign gender_str = raw_gender.label
    elsif raw_gender.name != blank
      assign gender_str = raw_gender.name
    elsif raw_gender.title != blank
      assign gender_str = raw_gender.title
    elsif raw_gender.value != blank
      assign gender_str = raw_gender.value
    else
      assign gender_str = raw_gender
    endif

    assign g = gender_str | default: '' | handleize
    assign v = product.vendor | handleize
    assign t = product.type | handleize

    assign genders_to_check = ''
    if g == 'm' or g == 'men' or g == 'mens' or g == 'male'
      assign genders_to_check = 'mens,male,men,m' | split: ','
    elsif g == 'f' or g == 'w' or g == 'women' or g == 'womens' or g == 'female'
      assign genders_to_check = 'female,womens,women,f' | split: ','
    elsif g == 'u' or g == 'unisex'
      assign genders_to_check = 'unisex,u' | split: ','
    elsif g != blank
      assign genders_to_check = g | split: ','
    endif

    assign t_alt = t
    if t != blank
      assign t_size = t.size
      assign last_char = t | slice: -1, 1
      if last_char == 's' and t_size > 1
        assign t_len = t_size | minus: 1
        assign t_alt = t | slice: 0, t_len
      else
        assign t_alt = t | append: 's'
      endif
    endif

    assign types_to_check = ''
    if t != blank
      if t_alt != blank and t_alt != t
        assign types_to_check = t | append: ',' | append: t_alt | split: ','
      else
        assign types_to_check = t | split: ','
      endif
    endif

    # 1. Try gender + vendor + type combinations
    if guide == blank and genders_to_check != blank and v != blank and types_to_check != blank
      for gen in genders_to_check
        if guide != blank
          break
        endif
        for typ in types_to_check
          assign k = gen | append: '-' | append: v | append: '-' | append: typ
          assign guide = shop.metaobjects.size_guide[k] | default: shop.metaobjects['size-guide'][k] | default: shop.metaobjects.size_chart[k] | default: shop.metaobjects.size_guides[k]
          if guide == blank
            assign k_sizes = k | append: '-sizes'
            assign guide = shop.metaobjects.size_guide[k_sizes] | default: shop.metaobjects['size-guide'][k_sizes] | default: shop.metaobjects.size_chart[k_sizes] | default: shop.metaobjects.size_guides[k_sizes]
          endif
          if guide == blank
            assign k_size = k | append: '-size'
            assign guide = shop.metaobjects.size_guide[k_size] | default: shop.metaobjects['size-guide'][k_size] | default: shop.metaobjects.size_chart[k_size] | default: shop.metaobjects.size_guides[k_size]
          endif
          if guide != blank
            break
          endif
        endfor
      endfor
    endif

    # 2. Try vendor + type combinations
    if guide == blank and v != blank and types_to_check != blank
      for typ in types_to_check
        assign k = v | append: '-' | append: typ
        assign guide = shop.metaobjects.size_guide[k] | default: shop.metaobjects['size-guide'][k] | default: shop.metaobjects.size_chart[k] | default: shop.metaobjects.size_guides[k]
        if guide == blank
          assign k_sizes = k | append: '-sizes'
          assign guide = shop.metaobjects.size_guide[k_sizes] | default: shop.metaobjects['size-guide'][k_sizes] | default: shop.metaobjects.size_chart[k_sizes] | default: shop.metaobjects.size_guides[k_sizes]
        endif
        if guide != blank
          break
        endif
      endfor
    endif

    # 3. Try gender + type combinations
    if guide == blank and genders_to_check != blank and types_to_check != blank
      for gen in genders_to_check
        if guide != blank
          break
        endif
        for typ in types_to_check
          assign k = gen | append: '-' | append: typ
          assign guide = shop.metaobjects.size_guide[k] | default: shop.metaobjects['size-guide'][k] | default: shop.metaobjects.size_chart[k] | default: shop.metaobjects.size_guides[k]
          if guide == blank
            assign k_sizes = k | append: '-sizes'
            assign guide = shop.metaobjects.size_guide[k_sizes] | default: shop.metaobjects['size-guide'][k_sizes] | default: shop.metaobjects.size_chart[k_sizes] | default: shop.metaobjects.size_guides[k_sizes]
          endif
          if guide != blank
            break
          endif
        endfor
      endfor
    endif

    # 4. Try type combinations
    if guide == blank and types_to_check != blank
      for typ in types_to_check
        assign guide = shop.metaobjects.size_guide[typ] | default: shop.metaobjects['size-guide'][typ] | default: shop.metaobjects.size_chart[typ] | default: shop.metaobjects.size_guides[typ]
        if guide == blank
          assign k_sizes = typ | append: '-sizes'
          assign guide = shop.metaobjects.size_guide[k_sizes] | default: shop.metaobjects['size-guide'][k_sizes] | default: shop.metaobjects.size_chart[k_sizes] | default: shop.metaobjects.size_guides[k_sizes]
        endif
        if guide != blank
          break
        endif
      endfor
    endif
  endif

  # 3. Extract content from Metaobject entry (guide) if found
  if guide != blank
    assign has_size_chart = true
    assign meta_img = guide.size_guide_image.value | default: guide.image.value | default: guide.size_guide_image | default: guide.image | default: guide.size_chart_image.value | default: guide.size_chart_image | default: guide.size_chart.value | default: guide.size_chart | default: guide.size_guide_file.value | default: guide.size_guide_file | default: guide.size_chart_file.value | default: guide.size_chart_file | default: guide.file.value | default: guide.file | default: guide.photo.value | default: guide.photo | default: guide.picture.value | default: guide.picture

    if meta_img != blank
      assign is_image = true
      assign size_chart_image = meta_img
    else
      assign meta_text = guide.content.value | default: guide.content | default: guide.details.value | default: guide.details | default: guide.description.value | default: guide.description | default: guide.text.value | default: guide.text | default: guide.html.value | default: guide.html
      if meta_text != blank
        assign size_chart_details = meta_text
      endif
    endif
  endif

  # 2. Theme settings / metafield fallbacks if no Metaobject found
  if has_size_chart == false
    if size_chart_type == 'metafield' or product.metafields.custom.size_chart != blank
      if product.metafields.custom.size_chart
        assign has_size_chart = true
        assign size_chart_metafield = product.metafields.custom.size_chart
        assign size_chart_value = size_chart_metafield.value | default: size_chart_metafield

        if size_chart_metafield.type == 'file_reference' or size_chart_value.width != blank or size_chart_value.aspect_ratio != blank or size_chart_value.src != blank
          assign is_image = true
          assign size_chart_image = size_chart_value
        else
          capture size_chart_str
            echo size_chart_value
          endcapture
          assign size_chart_str_clean = size_chart_str | strip
          if size_chart_str_clean contains 'http' or size_chart_str_clean contains '//cdn.shopify' or size_chart_str_clean contains '/files/' or size_chart_str_clean contains '.jpg' or size_chart_str_clean contains '.png' or size_chart_str_clean contains '.webp'
            assign is_image_url = true
            assign size_chart_image_url = size_chart_str_clean
          else
            assign size_chart_details = size_chart_value
          endif
        endif
      endif
    elsif size_chart_type == 'image'
      if bl_stts.size_chart_image != blank
        assign has_size_chart = true
        assign is_image = true
        assign size_chart_image = bl_stts.size_chart_image
      endif
    elsif size_chart_type == 'page'
      if bl_stts.size_chart_page != blank
        assign has_size_chart = true
        assign size_chart_heading = bl_stts.size_chart_page.title
        assign size_chart_details = bl_stts.size_chart_page.content
      endif
    endif
  endif
-%}

{%- if has_size_chart -%}
  <side-drawer-opener
    class="popup size-chart product-popup-modal__opener--keep"
    {{ block.shopify_attributes }}
    data-side-drawer="#PopupModal-{{ block.id }}"
  >
    <button
      id="PopupModalButton-{{ block.id }}"
      class="button button-unstyled popup__button spacing-style"
      type="button"
      style="
        {% render 'spacing-style', settings: bl_stts %}
      "
    >
    <span
    class="{{ bl_stts.type_preset }} {{ text_block_classes }}" style="{% render 'typography-style', settings: bl_stts, weight: bl_stts.font_weight %}"
    >
    {{- 'icon-size-chart.svg' | inline_asset_content -}}
        {{- bl_stts.heading }}
      </span>
    </button>
  </side-drawer-opener>

  <side-drawer
    class="popup__content product-popup-modal__drawer--keep drawer fixed top-0 left-0 z-10 w-screen h-full flex-center no-js-hidden"
    element-s-popup
    id="PopupModal-{{ block.id }}"
    data-drawer-direction="center"
  >
    <div id="Drawer-Overlay-{{ block.id }}" class="drawer__overlay fixed inset-0 cursor-pointer"></div>
    <div
      class="popup__inner color-{{ settings.popover_color_scheme }} w-full h-auto flex flex-column global-settings-popup cus-scrollbar"
      role="dialog"
      aria-modal="true"
      aria-label="Size chart"
      tabindex="-1"
      style="--modal-max-width: 72rem;"
      data-drawer-content
    >
      <button
        onclick="this.closest('side-drawer').close()"
        class="drawer__close block t-button bor-none rounded-full cursor-pointer absolute button-close-circle"
        type="button"
        aria-label="{{ 'accessibility.close_dialog' | t }}"
        style="--top: 1rem; --right: 1rem;"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
      <div class="w-full h-full overflow-auto cus-scrollbar" style="--p: 1rem;">
        <div class="drawer__header relative center"
          style="--p: 1.5rem 0; --mb: 2.5rem;"
        >
          <h5 class="drawer__heading break m-0">
            {{ size_chart_heading | default: 'products.product.size_chart.name_popup' }}
          </h5>
        </div>
        <div class="size-chart-popup-modal__content-info m-auto w-full">
          <div class="size-chart-details center w-full flex justify-center">
            {%- if is_image and size_chart_image != blank -%}
              {{
                size_chart_image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  class: 'w-full h-auto object-contain m-auto',
                  widths: '375, 550, 750, 1100, 1400',
                  alt: size_chart_heading | default: 'Size chart'
              }}
            {%- elsif is_image_url -%}
              <img
                src="{{ size_chart_image_url }}"
                alt="{{ size_chart_heading | default: 'Size chart' | escape }}"
                loading="lazy"
                class="w-full h-auto object-contain m-auto"
              >
            {%- elsif size_chart_details != blank -%}
              <div class="rte w-full">
                {{ size_chart_details }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </side-drawer>
{%- endif -%}

