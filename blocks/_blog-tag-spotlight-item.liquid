{% doc %}
  Renders a single Blog Tag Spotlight item with customizable product card blocks.
{% enddoc %}

{%- liquid
  assign b_stts = block.settings
  assign tag_handle = b_stts.tag_name | downcase | handleize
  assign active_tag_handle = current_tags.first | downcase | handleize
  assign article_obj = b_stts.article

  if article_obj == blank and tag_handle != blank
    for article in blog.articles
      for t in article.tags
        assign t_handle = t | handleize
        if t_handle == tag_handle
          assign article_obj = article
          break
        endif
      endfor
      if article_obj != blank
        break
      endif
    endfor
  endif
  
  assign spotlight_image = b_stts.image | default: article_obj.image
  assign spotlight_title = b_stts.title | default: article_obj.title
  assign spotlight_author = b_stts.author | default: article_obj.author
  
  if b_stts.date != blank
    assign spotlight_date = b_stts.date
  elsif article_obj != blank
    assign spotlight_date = article_obj.published_at | date: "%d/%m/%Y"
  else
    assign spotlight_date = nil
  endif

  assign spotlight_link = b_stts.link | default: article_obj.url
-%}

<div 
  class="blog-tag-spotlight-item blog-tag-spotlight blog-tag-spotlight--media-{{ b_stts.media_position }}" 
  data-tag="{{ tag_handle }}"
  data-is-default="{{ b_stts.is_default }}"
  style="display: none;"
  {{ block.shopify_attributes }}
>
  {%- comment -%} Left Column: Media Banner {%- endcomment -%}
  <div class="blog-tag-spotlight__media-col">
    <a href="{{ spotlight_link | default: '#' }}" class="blog-tag-spotlight__media-link" aria-label="{{ spotlight_title | escape }}">
      {%- if spotlight_image != blank -%}
        {{ spotlight_image | image_url: width: 1200 | image_tag: 
          loading: 'lazy',
          sizes: '(min-width: 990px) 55vw, 100vw',
          widths: '375, 550, 750, 1100, 1500',
          class: 'blog-tag-spotlight__image' 
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'blog-tag-spotlight__image placeholder-svg' }}
      {%- endif -%}
    </a>
  </div>

  {%- comment -%} Right Column: Information & Related Products {%- endcomment -%}
  <div class="blog-tag-spotlight__content-col">
    {%- comment -%} Header Tag Pills {%- endcomment -%}
    {%- if b_stts.tags_list != blank -%}
      {%- assign tag_array = b_stts.tags_list | split: ',' -%}
      <div class="blog-tag-spotlight__tags">
        {%- for tag_item in tag_array -%}
          {%- assign clean_tag = tag_item | strip -%}
          {%- if clean_tag != blank -%}
            {%- assign tag_h = clean_tag | handleize -%}
            {%- assign tag_u = blog.url | append: '/tagged/' | append: tag_h -%}
            {% render 'button',
              link: tag_u,
              label: clean_tag,
              style_class: 'button-secondary',
              button_style: 'custom',
              button_border_width: 1,
              button_border_radius: 4,
              button_type_size: '1.5rem',
              button_type_line_height: 'normal',
              button_type_letter_spacing: 1,
              button_font_weight: '400',
              button_text_case: 'uppercase',
              button_type_alignment: 'center',
              buttons_shadow_horizontal_offset: 0,
              buttons_shadow_vertical_offset: 0,
              buttons_shadow_blur: 0,
              style: 'padding: 0.7rem 3.4rem !important;'
            %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif article_obj != blank and article_obj.tags.size > 0 -%}
      <div class="blog-tag-spotlight__tags">
        {%- for tag_item in article_obj.tags -%}
          {%- assign tag_h = tag_item | handleize -%}
          {%- assign tag_u = blog.url | append: '/tagged/' | append: tag_h -%}
          {% render 'button',
            link: tag_u,
            label: tag_item,
            style_class: 'button-secondary',
            button_style: 'custom',
            button_border_width: 1,
            button_border_radius: 4,
            button_type_size: '1.5rem',
            button_type_line_height: 'normal',
            button_type_letter_spacing: 1,
            button_font_weight: '400',
            button_text_case: 'uppercase',
            button_type_alignment: 'center',
            buttons_shadow_horizontal_offset: 0,
            buttons_shadow_vertical_offset: 0,
            buttons_shadow_blur: 0,
            style: 'padding: 0.7rem 3.4rem !important;'
          %}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {% capture item_title %}
      {% content_for 'block', id: 'heading', type: '_heading', text: spotlight_title %}
    {% endcapture %}

    {% capture item_details %}
      {% content_for 'block', id: 'blog-post-details', type: '_blog-post-info-text', alignment: 'center', article: article_obj %}
    {% endcapture %}

    {%- if spotlight_link != blank -%}
      <a href="{{ spotlight_link }}" class="decoration-none block">
        {{ item_title }}
      </a>
    {%- else -%}
      {{ item_title }}
    {%- endif -%}

    {{ item_details }}

    {%- comment -%} Related Products Section {%- endcomment -%}
    <div class="blog-tag-spotlight__products-wrapper">
      {%- if b_stts.products_heading != blank -%}
        <h3 class="blog-tag-spotlight__products-heading">{{ b_stts.products_heading }}</h3>
      {%- endif -%}

      {%- liquid
        assign products_to_show = b_stts.product_list
        if products_to_show == blank and b_stts.collection != blank
          assign products_to_show = b_stts.collection.products
        endif
        if products_to_show == blank and article_obj != blank
          if article_obj.metafields.custom.related_products.value != blank
            assign products_to_show = article_obj.metafields.custom.related_products.value
          elsif article_obj.metafields.custom.featured_products.value != blank
            assign products_to_show = article_obj.metafields.custom.featured_products.value
          endif
        endif
        if products_to_show == blank
          assign lookup_tag = tag_handle
          if lookup_tag == blank
            assign lookup_tag = active_tag_handle
          endif
          if lookup_tag != blank and collections[lookup_tag] != blank
            assign products_to_show = collections[lookup_tag].products
          endif
        endif
      -%}

      {%- if products_to_show != blank -%}
        <div class="blog-tag-spotlight__products-grid">
          {%- for product_item in products_to_show limit: b_stts.products_limit -%}
            <div 
              class="blog-tag-spotlight__product-card-item"
              style="--card-title-size: {{ b_stts.card_title_size | default: 15 }}px; --card-price-size: {{ b_stts.card_price_size | default: 14 }}px;"
            >
              <div class="spotlight-product-card">
                {%- liquid
                  assign ratio_setting = b_stts.card_image_ratio | default: 'square'
                  if ratio_setting == 'custom' and b_stts.custom_image_ratio != blank
                    assign custom_ratio_style = 'style="aspect-ratio: ' | append: b_stts.custom_image_ratio | append: ';"'
                  else
                    assign custom_ratio_style = ''
                  endif
                -%}
                <div class="spotlight-product-card__media-wrapper ratio-{{ ratio_setting }}" {{ custom_ratio_style }}>
                  <a href="{{ product_item.url }}" class="spotlight-product-card__media-link" aria-label="{{ product_item.title | escape }}">
                    {%- if product_item.featured_media -%}
                      {{ product_item.featured_media | image_url: width: 600 | image_tag:
                        loading: 'lazy',
                        sizes: '(min-width: 750px) 25vw, 50vw',
                        widths: '200, 400, 600',
                        class: 'spotlight-product-card__image'
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'spotlight-product-card__image placeholder-svg' }}
                    {%- endif -%}
                  </a>
                  {%- if settings.enable_quick_view -%}
                    {%- liquid
                      assign quick_add_type_icon = false
                      if settings.quick_add_type == 'icon'
                        assign quick_add_type_icon = true
                        assign class_button = 'card-product__group-btn rounded-full bor-none center cursor-pointer flex items-center justify-center relative w-fit leading-none'
                        assign class_text = 'text whitespace-nowrap overflow-hidden pointer-events-none absolute-c-y z--1 opacity-0'
                        assign class_text_inner = 'text-inner inline-block'
                      endif
                    -%}
                    <div class="spotlight-product-card__quickview-overlay">
                      <div class="card--block-button relative z-2 w-full size-style">
                        <div class="quick-view w-full">
                          <modal-opener data-modal="#QuickViewStandard">
                            <button
                              type="button"
                              class="quickview-button quick-add__submit button-secondary button--full-width {{ class_button }}"
                              aria-haspopup="dialog"
                              title="{{ 'products.product.quick_view' | t }}"
                              data-product-url="{{ product_item.url }}"
                              data-product-id="{{ product_item.id }}"
                              data-open-quick-view-popup
                              data-product-handle="{{ product_item.handle }}"
                            >
                              {%- if quick_add_type_icon == false -%}
                                <span class="button-overflow relative overflow-hidden" data-button-text="{{ 'products.product.quick_view' | t }}">
                                  <span class="button-text-main inline-block relative z-1">
                                    {{ 'products.product.quick_view' | t }}
                                  </span>
                                </span>
                              {%- else -%}
                                <span class="text-in-mb md:hidden">
                                  {{ 'products.product.quick_view' | t }}
                                </span>
                                <span class="{{ class_text }}">
                                  <span class="{{ class_text_inner }}">{{ 'products.product.quick_view' | t }}</span>
                                </span>
                                <svg
                                  class="quickview-button__icon"
                                  aria-hidden="true"
                                  focusable="false"
                                  xmlns="http://www.w3.org/2000/svg"
                                  viewBox="0 0 20 20"
                                  width="16"
                                  height="16"
                                >
                                  {% render 'icon', icon: 'eye' %}
                                </svg>
                              {%- endif -%}
                              {%- render 'loading-spinner' -%}
                            </button>
                          </modal-opener>
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                </div>

                {%- if b_stts.show_vendor != false and product_item.vendor != blank -%}
                  <div class="spotlight-product-card__vendor">
                    {%- liquid
                      assign vendor_handle = product_item.vendor | handle
                      assign vendor_img_png = vendor_handle | append: '.png'
                      assign vendor_img_jpg = vendor_handle | append: '.jpg'
                      assign vendor_img_svg = vendor_handle | append: '.svg'
                      assign vendor_img = images[vendor_img_png] | default: images[vendor_img_jpg] | default: images[vendor_img_svg]
                    -%}
                    {%- if vendor_img != blank -%}
                      <img src="{{ vendor_img | image_url: width: 200 }}" alt="{{ product_item.vendor | escape }}" class="spotlight-product-card__vendor-img" width="{{ vendor_img.width }}" height="{{ vendor_img.height }}">
                    {%- else -%}
                      <span class="spotlight-product-card__vendor-text">{{ product_item.vendor }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                <h4 class="spotlight-product-card__title">
                  <a href="{{ product_item.url }}">{{ product_item.title }}</a>
                </h4>

                <div class="spotlight-product-card__price">
                  {% render 'price-product', product_resource: product_item, show_savings: b_stts.show_savings %}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Spotlight Tag Item",
  "tag": null,
  "blocks": [
    {
      "type": "card-product-flex"
    },
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Tag Identification"
    },
    {
      "type": "text",
      "id": "tag_name",
      "label": "Tag handle / name",
      "info": "Enter the exact tag name (e.g. harkila, news-and-events). Leave empty if this is the default block."
    },
    {
      "type": "checkbox",
      "id": "is_default",
      "label": "Set as Default Spotlight Item",
      "default": false,
      "info": "This item displays when no tag filter is active or when no tag matches."
    },
    {
      "type": "header",
      "content": "Banner & Article Content"
    },
    {
      "type": "article",
      "id": "article",
      "label": "Select Featured Article (Optional)",
      "info": "Auto-populates image, title, author, and date if left blank."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image (Override)"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner link"
    },
    {
      "type": "text",
      "id": "tags_list",
      "label": "Pill tags list (Comma-separated)",
      "default": "AUTHOR:ISOBEL, HARKILA, NEWS AND EVENTS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Spotlight Title (Override)",
      "default": "Vinnie Jones In The Country Series 2"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author name (Override)",
      "default": "Isobel"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Publication date (Override)",
      "default": "6/12/2024"
    },
    {
      "type": "header",
      "content": "Related Products Settings"
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Products section heading",
      "default": "RELATED PRODUCTS"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Featured Products",
      "limit": 4
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Or Select Collection",
      "info": "Used if no individual products are selected above."
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    },
    {
      "type": "header",
      "content": "Product Card Settings"
    },
    {
      "type": "select",
      "id": "card_image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "custom", "label": "Custom ratio" }
      ],
      "default": "square"
    },
    {
      "type": "text",
      "id": "custom_image_ratio",
      "label": "Custom image ratio (width/height)",
      "default": "441/318",
      "info": "Enter ratio like 441/318 or 16/9. Only applies when Custom ratio is selected above."
    },
    {
      "type": "range",
      "id": "card_title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 15,
      "unit": "px",
      "label": "Title font size (px)"
    },
    {
      "type": "range",
      "id": "card_price_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 14,
      "unit": "px",
      "label": "Price font size (px)"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor / brand logo",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Show savings (You save...)",
      "default": true
    }
  ]
}
{% endschema %}
