{% assign alignment = alignment | default: block.settings.alignment %}
{% assign target_article = article | default: block.settings.article %}
{% assign display_layout = block.settings.display_layout | default: 'horizontal' %}

{%- if block.settings.show_date or block.settings.show_author -%}
  <div
    class="
      blog-post-details
      blog-post-details--{{ display_layout }}
      spacing-style
      justify-{{ alignment }}
      {% if block.settings.type_preset != '' %}{{ block.settings.type_preset }}{% endif%}
    "
    style="
      {% render 'spacing-style', settings: block.settings %}
      {% if display_layout == 'vertical' %}
        display: flex; flex-direction: column; align-items: {% if alignment == 'center' %}center{% elsif alignment == 'right' %}flex-end{% else %}flex-start{% endif %}; gap: 0.4rem;
      {% else %}
        display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: {% if alignment == 'center' %}center{% elsif alignment == 'right' %}flex-end{% else %}flex-start{% endif %}; gap: 0.8rem;
      {% endif %}
    "
  >
    {%- if block.settings.show_author and target_article.author != blank -%}
      <span class="blog-author">
        Posted by {{ target_article.author }} 
        {%- if block.settings.show_date and target_article.published_at != blank -%}on{%- endif -%}
      </span>
    {%- endif -%}

    {%- if block.settings.show_date and target_article.published_at != blank -%}
      <span class="blog-date">
        {{ target_article.published_at | date: "%d/%m/%Y" }}
      </span>
    {%- endif -%}

    {% if block.settings.show_comments and target_article.comments_count > 0 %}
      <span>{{ 'blogs.article.blog_details_separator' | t }}</span>
      <span class="blog-comment">{{ 'blogs.article.comments' | t: count: target_article.comments_count }}</span>
    {%- endif -%}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:names.details",
  "settings": [
    {
      "type": "select",
      "id": "display_layout",
      "label": "Layout direction",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:settings.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:settings.show_author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "t:settings.show_comments",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.preset",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "paragraph",
          "label": "t:options.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.h1"
        },
        {
          "value": "h2",
          "label": "t:options.h2"
        },
        {
          "value": "h3",
          "label": "t:options.h3"
        },
        {
          "value": "h4",
          "label": "t:options.h4"
        },
        {
          "value": "h5",
          "label": "t:options.h5"
        },
        {
          "value": "h6",
          "label": "t:options.h6"
        }
      ],
      "default": "",
      "info": "t:info.edit_presets_in_theme_settings"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left",
      "visible_if": "{{ block.settings.show_alignment != false }}"
    },
    {
      "type": "checkbox",
      "id": "show_alignment",
      "label": "t:settings.show_alignment",
      "default": true,
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.details"
    }
  ]
}
{% endschema %}
