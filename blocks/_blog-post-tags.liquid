{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{%- liquid
  assign bl_stts = block.settings
  assign show_tags = bl_stts.show_tags
  assign align_class = 'justify-center'
  if bl_stts.alignment == 'left'
    assign align_class = 'justify-start'
  elsif bl_stts.alignment == 'right'
    assign align_class = 'justify-end'
  endif

  assign style_class = bl_stts.style_class | default: bl_stts.tags_style_class | default: 'button-secondary'
  assign button_style = bl_stts.button_style | default: bl_stts.tags_button_style | default: 'default'
  assign button_border_width = bl_stts.button_border_width | default: bl_stts.tags_button_border_width
  assign button_border_radius = bl_stts.button_border_radius | default: bl_stts.tags_button_border_radius
  assign button_text_case = bl_stts.button_text_case | default: bl_stts.tags_button_text_case | default: 'uppercase'

  if bl_stts.custom_padding_button
    assign btn_padding_block_rem = bl_stts.button_padding_block | divided_by: 10.0 | append: 'rem'
    assign btn_padding_inline_rem = bl_stts.button_padding_inline | divided_by: 10.0 | append: 'rem'
    assign btn_padding_block_px = bl_stts.button_padding_block | append: 'px'
    assign btn_padding_inline_px = bl_stts.button_padding_inline | append: 'px'
    assign btn_padding_style = '--button-padding-vertical: ' | append: btn_padding_block_rem | append: ' !important; --button-padding-horizontal: ' | append: btn_padding_inline_rem | append: ' !important; --button-padding-vertical-mobile: ' | append: btn_padding_block_rem | append: ' !important; --button-padding-horizontal-mobile: ' | append: btn_padding_inline_rem | append: ' !important; padding-block: ' | append: btn_padding_block_px | append: ' !important; padding-inline: ' | append: btn_padding_inline_px | append: ' !important; padding: ' | append: btn_padding_block_px | append: ' ' | append: btn_padding_inline_px | append: ' !important;'
  else
    assign btn_padding_style = nil
  endif

  assign has_recipe = false
  if article.content contains 'blogPost__recipes'
    assign has_recipe = true
  endif
-%}

<style>
  .article-tag.blog-tags {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .article-tag.blog-tags .blog-post-card__tags {
    flex: 1 1 auto;
  }

  .blog-post-jump-recipe {
    flex-shrink: 0;
    margin: 0 auto;
  }

  .button--jump-recipe {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 20px;
    font-size: 14px;
    font-weight: 600;
    line-height: 18px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 4px;
    cursor: pointer;
  }
  .button--jump-recipe svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
    fill: transparent !important;
    ;
  }

  .button--jump-recipe:hover svg {
    transform: translateY(2px);
  }

  @media only screen and (max-width: 768px) {
    .article-tag.blog-tags {
      flex-direction: column;
      align-items: flex-start;
    }
    .blog-post-jump-recipe {
      width: 100%;
    }
    .button--jump-recipe {
      width: 100%;
    }
  }
</style>

<div class="spacing-style w-full mx-auto" style="margin-left: auto; margin-right: auto; {% render 'spacing-style', settings: bl_stts %}">
  {% render 'group', children: children, shopify_attributes: block.shopify_attributes %}

  {%- if show_tags -%}
    {%- if article.tags.size > 0 -%}
      <div class="article-tag blog-tags w-full flex items-center justify-between flex-wrap gap-4{% if has_recipe %} has-jump-recipe has-jumb-recipe{% endif %}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}">
        <div class="blog-post-card__tags flex flex-wrap items-center {{ align_class }}" style="gap: {{ bl_stts.gap | default: 8 }}px;">
          {%- for tag in article.tags -%}
            {%- assign tag_handle = tag | handleize -%}
            {%- assign tag_url = blog.url | append: '/tagged/' | append: tag_handle -%}
            {%- liquid
              assign btn_width = nil
              if bl_stts.custom_padding_button
                assign btn_width = 'custom'
              endif
            -%}
            {% render 'button',
              link: tag_url,
              label: tag,
              style_class: style_class,
              button_style: button_style,
              button_border_width: button_border_width,
              button_border_radius: button_border_radius,
              button_type_font: bl_stts.button_type_font,
              button_type_size: bl_stts.button_type_size,
              button_type_line_height: bl_stts.button_type_line_height,
              button_type_letter_spacing: bl_stts.button_type_letter_spacing,
              button_font_weight: bl_stts.button_font_weight,
              button_text_case: button_text_case,
              button_type_alignment: bl_stts.button_type_alignment,
              buttons_shadow_horizontal_offset: bl_stts.buttons_shadow_horizontal_offset,
              buttons_shadow_vertical_offset: bl_stts.buttons_shadow_vertical_offset,
              buttons_shadow_blur: bl_stts.buttons_shadow_blur,
              width: btn_width,
              buttons_padding_vertical: bl_stts.button_padding_block,
              buttons_padding_horizontal: bl_stts.button_padding_inline,
              style: 'width: auto !important; max-width: max-content; ' | append: btn_padding_style
            %}
          {%- endfor -%}
        </div>

        <div class="blog-post-jump-recipe{% unless has_recipe %} hidden{% endunless %}">
          <a href="#blogPost__recipes" class="button button--primary button--jump-recipe" role="button" aria-label="Jump to recipe">
            <span>JUMP TO RECIPE</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <polyline points="19 12 12 19 5 12"></polyline>
            </svg>
          </a>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

<script>
  (function() {
    function initJumpToRecipe(scope) {
      const root = scope || document;
      const recipeEl = document.querySelector('.blogPost__recipes');
      const jumpWrappers = root.querySelectorAll('.blog-post-jump-recipe');
      const tagContainers = root.querySelectorAll('.article-tag.blog-tags');

      if (recipeEl) {
        jumpWrappers.forEach(function(el) {
          el.classList.remove('hidden');
        });
        tagContainers.forEach(function(el) {
          el.classList.add('has-jump-recipe', 'has-jumb-recipe');
        });
      } else {
        jumpWrappers.forEach(function(el) {
          el.classList.add('hidden');
        });
      }

      root.querySelectorAll('.button--jump-recipe').forEach(function(btn) {
        if (btn.dataset.jumpInit) return;
        btn.dataset.jumpInit = 'true';
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const target = document.querySelector('.blogPost__recipes');
          if (target) {
            const header = document.querySelector('.header') || document.querySelector('#header-group') || document.querySelector('.sticky-header');
            const headerHeight = header ? header.offsetHeight : 0;
            const targetTop = target.getBoundingClientRect().top + window.pageYOffset - headerHeight - 20;
            window.scrollTo({
              top: targetTop,
              behavior: 'smooth'
            });
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initJumpToRecipe();
      });
    } else {
      initJumpToRecipe();
    }

    document.addEventListener('shopify:section:load', function(e) {
      initJumpToRecipe(e.target);
    });
  })();
</script>

{% schema %}
{
  "name": "t:names.blog_post_tags",
  "tag": null,
  "blocks": [
    { "type": "text" },
    { "type": "icon" },
    { "type": "group" }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:settings.show_tags",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between tags",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Button Styling"
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "Button style class",
      "options": [
        { "value": "button-secondary", "label": "Secondary" },
        { "value": "button-primary", "label": "Primary" },
        { "value": "button-outline", "label": "Outline" }
      ],
      "default": "button-secondary"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style mode",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Border width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.button_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 4,
      "visible_if": "{{ block.settings.button_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "button_type_font",
      "label": "t:settings.font",
      "visible_if": "{{ block.settings.button_style == 'custom' }}",
      "options": [
        {
          "value": "var(--font-body--family)",
          "label": "t:options.body"
        },
        {
          "value": "var(--font-subheading--family)",
          "label": "t:options.subheading"
        },
        {
          "value": "var(--font-heading--family)",
          "label": "t:options.heading"
        }
      ],
      "default": "var(--font-body--family)"
    },
    {
      "type": "select",
      "id": "button_type_size",
      "label": "Font size",
      "options": [
        { "value": "1.2rem", "label": "12px" },
        { "value": "1.4rem", "label": "14px" },
        { "value": "1.5rem", "label": "15px" },
        { "value": "1.6rem", "label": "16px" }
      ],
      "default": "1.5rem"
    },
    {
      "type": "select",
      "id": "button_text_case",
      "label": "Text case",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "uppercase"
    },
    {
      "type": "checkbox",
      "id": "custom_padding_button",
      "label": "Custom button padding",
      "default": false
    },
    {
      "type": "range",
      "id": "button_padding_block",
      "label": "Vertical padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ block.settings.custom_padding_button }}"
    },
    {
      "type": "range",
      "id": "button_padding_inline",
      "label": "Horizontal padding",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.custom_padding_button }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.blog_post_tags",
      "category": "t:categories.blog"
    }
  ]
}
{% endschema %}
