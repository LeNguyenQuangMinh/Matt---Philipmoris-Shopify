{% liquid
  assign pl = block.settings.padding_left
  assign pr = block.settings.padding_right
  assign pt = block.settings.padding_top
  assign pb = block.settings.padding_bottom

  assign label = block.settings.label
  assign show_label = block.settings.show_label
  assign label_type_preset = block.settings.label_type_preset
  assign border_style = block.settings.border_style
  assign is_required = block.settings.is_required
  assign placeholder = block.settings.placeholder
  assign label_mb = block.settings.label_mb
  assign input_border_width = block.settings.input_border_width
  assign input_border_radius = block.settings.input_border_radius
  assign input_type_preset = block.settings.input_type_preset
  assign input_alignment = block.settings.input_alignment
  assign input_width = block.settings.input_width

  if label == blank or show_label == false
    assign label_name = placeholder | handleize | append: '-input'
  else 
    assign label_name = label | handleize
  endif  
%}

{%- capture attr -%}
  class="border-style--{{ border_style }} w-full block contact-form-input {{ input_type_preset }} {{ input_alignment }}" {{ block.shopify_attributes }}
  style="
    {% if pl != 0 %}--pl:{{ pl }}px;{% endif %}
    {% if pt != 0 %}--pt:{{ pt }}px;{% endif %}
    {% if pb != 0 %}--pb:{{ pb }}px;{% endif %}
    {% if pr != 0 %}--pr:{{ pr }}px;{% endif %}
    {% if input_border_width != 0 %}--border-width: {{ input_border_width }}px;{% endif %}
    {% if input_border_radius != 0 %}--border-radius: {{ input_border_radius }}px;{% endif %}
  "
{%- endcapture -%}

{%- if show_label -%}
  {% if label != blank %}
    <div class="contact-form-row" style="--formRowWidth: {{ input_width }}%;">
      <label for="{{ block.id }}" style="--mb:{{ label_mb }}px; {% if label_type_preset == 'custom' %}{% render 'typography-style', settings: block.settings, preset: label_type_preset, weight: block.settings.font_weight %}{% endif %}" class="block {{ label_type_preset }}{% if label_type_preset == 'custom' %} custom-typography{% if block.settings.font_size != blank %} custom-font-size{% endif %}{% endif %}">{{ label }}{% if is_required %}<small><span aria-hidden="true" class="required-text">Required</span></small>{% endif %}</label>
      <input id="{{ block.id }}" type="text" name="contact[{{ label_name }}]" placeholder="{{ placeholder }}"{% if is_required %} required{% endif %} {{ attr }}>
    </div>
  {% else %}
    <div class="contact-form-row" style="--formRowWidth: {{ input_width }}%;">
      <input id="{{ block.id }}" type="text" name="contact[{{ label_name }}]" placeholder="{{ placeholder }}"{% if is_required %} required{% endif %} {{ attr }}>
    </div>
  {% endif %}
{%- endif -%}

