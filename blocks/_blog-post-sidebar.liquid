{%- capture children -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{%- liquid
  assign enable_drawer = section.settings.enable_drawer_sidebar
-%}

<side-drawer
  class="blog-posts__sidebar-drawer drawer__container{% if enable_drawer %} blog-posts__sidebar-drawer--desktop-drawer{% endif %}"
  id="Drawer-Blog-Sidebar"
  data-drawer-direction="left"
>
  <div id="Drawer-Overlay-Blog-Sidebar" class="drawer__overlay fixed inset-0 cursor-pointer{% unless enable_drawer %} lg:none{% endunless %}"></div>
  <div class="blog-posts__sidebar-container" data-drawer-content>
    <div class="blog-posts__sidebar flex flex-column hide-scrollbar">
      <div class="drawer__header flex justify-between items-center relative{% unless enable_drawer %} lg:none{% endunless %}">
        <h2 class="drawer__heading break m-0 h5">
          {%- if section.settings.drawer_title != blank -%}
            {{ section.settings.drawer_title }}
          {%- else -%}
            BLOGS
          {%- endif -%}
        </h2>
        <button
          class="drawer__close block t-button bor-none cursor-pointer drawer__close--square"
          type="button"
          onclick="this.closest('side-drawer').close()"
          aria-label="{{ 'accessibility.close_dialog' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
      </div>
      <div class="drawer__body-content flex flex-column">
        {{ children }}
      </div>
      {%- if enable_drawer -%}
        <div class="drawer__footer">
          <button
            type="button"
            class="button--drawer-close-footer"
            onclick="this.closest('side-drawer').close()"
          >
            CLOSE
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</side-drawer>

{% schema %}
{
  "name": "t:names.sidebar",
  "tag": null,
  "blocks": [
    { "type": "_blog-post-sidebar-most-recent" },
    { "type": "_blog-post-sidebar-most-popular" },
    { "type": "_blog-post-sidebar-category" },
    { "type": "_blog-post-sidebar-recent-posts" },
    { "type": "_blog-post-sidebar-products" },
    { "type": "_blog-post-sidebar-image" },
    { "type": "_blog-post-sidebar-text" },
    { "type": "_blog-post-sidebar-tags" }
  ],
  "settings": [],
  "presets": [
    {
      "name": "t:names.sidebar",
      "blocks": {
        "most_recent": {
          "type": "_blog-post-sidebar-most-recent",
          "name": "Most Recent"
        },
        "most_popular": {
          "type": "_blog-post-sidebar-most-popular",
          "name": "Most Popular"
        },
        "category": {
          "type": "_blog-post-sidebar-category",
          "name": "Category"
        },
        "recent_posts": {
          "type": "_blog-post-sidebar-recent-posts",
          "name": "Recent posts"
        },
        "products": {
          "type": "_blog-post-sidebar-products",
          "name": "Products"
        },
        "image": {
          "type": "_blog-post-sidebar-image",
          "name": "Image"
        },
        "text": {
          "type": "_blog-post-sidebar-text",
          "name": "Custom text"
        },
        "tags": {
          "type": "_blog-post-sidebar-tags",
          "name": "Tags"
        }
      }
    }
  ]
}
{% endschema %}
