{%- liquid
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
  if product == blank
    assign product = block.settings.product
  endif
  assign variant = product.selected_or_first_available_variant | default: product.variants.first

  assign gender_value = blank
  if block.settings.gender_metafield_key != blank
    assign key_parts = block.settings.gender_metafield_key | split: '.'
    if key_parts.size == 2
      assign ns = key_parts[0]
      assign key = key_parts[1]
      assign gender_value = product.metafields[ns][key].value | default: product.metafields[ns][key]
    else
      assign key = key_parts[0]
      assign gender_value = product.metafields.custom[key].value | default: product.metafields.custom[key]
    endif
  endif

  assign threshold = block.settings.stock_threshold | default: 5
  assign stock_qty = variant.inventory_quantity
  assign stock_policy = variant.inventory_policy
  assign stock_management = variant.inventory_management

  assign stock_status_class = "in-stock"
  assign stock_display_html = ""

  assign high_text_setting = block.settings.high_stock_text | default: "5+ In Stock - Available for immediate despatch"
  assign untracked_text_setting = block.settings.untracked_stock_text
  if untracked_text_setting == blank or untracked_text_setting contains '5+ In Stock'
    assign untracked_text_setting = "Available for despatch in 1 to 7 working days"
  endif
  assign low_text_setting = block.settings.low_stock_text | default: "[qty] In Stock - Available for immediate despatch"
  if low_text_setting == blank or low_text_setting == "Available for immediate despatch"
    assign low_text_setting = "[qty] In Stock - Available for immediate despatch"
  endif
  assign out_text_setting = block.settings.out_of_stock_text | default: "Out of Stock"

  if stock_management == blank or stock_management != 'shopify'
    assign stock_status_class = "in-stock not-track-stock"
    assign formatted_untracked = untracked_text_setting
    if formatted_untracked contains '-'
      assign parts = formatted_untracked | split: '-'
      assign prefix_part = parts[0] | append: '-'
      assign suffix_part = formatted_untracked | remove_first: parts[0] | remove_first: '-'
      capture stock_display_html
        echo '<span class="stock-prefix">' | append: prefix_part | append: '</span><span class="stock-suffix">' | append: suffix_part | append: '</span>'
      endcapture
    else
      capture stock_display_html
        echo '<span class="stock-prefix">' | append: formatted_untracked | append: '</span>'
      endcapture
    endif
  elsif variant.available == false
    if stock_policy == 'continue'
      assign stock_status_class = "in-stock not-track-stock"
      assign formatted_untracked = untracked_text_setting
      if formatted_untracked contains '-'
        assign parts = formatted_untracked | split: '-'
        assign prefix_part = parts[0] | append: '-'
        assign suffix_part = formatted_untracked | remove_first: parts[0] | remove_first: '-'
        capture stock_display_html
          echo '<span class="stock-prefix">' | append: prefix_part | append: '</span><span class="stock-suffix">' | append: suffix_part | append: '</span>'
        endcapture
      else
        capture stock_display_html
          echo '<span class="stock-prefix">' | append: formatted_untracked | append: '</span>'
        endcapture
      endif
    else
      assign stock_status_class = "out-of-stock"
      capture stock_display_html
        echo '<span class="stock-prefix">' | append: out_text_setting | append: '</span>'
      endcapture
    endif
  elsif stock_qty > threshold
    assign stock_status_class = "in-stock"
    assign formatted_high = high_text_setting | replace: "[qty]", stock_qty
    if formatted_high contains '-'
      assign parts = formatted_high | split: '-'
      assign prefix_part = parts[0] | append: '-'
      assign suffix_part = formatted_high | remove_first: parts[0] | remove_first: '-'
      capture stock_display_html
        echo '<span class="stock-prefix">' | append: prefix_part | append: '</span><span class="stock-suffix">' | append: suffix_part | append: '</span>'
      endcapture
    else
      capture stock_display_html
        echo '<span class="stock-prefix">' | append: formatted_high | append: '</span>'
      endcapture
    endif
  elsif stock_qty > 0
    assign stock_status_class = "low-stock"
    assign formatted_low = low_text_setting | replace: "[qty]", stock_qty
    if formatted_low contains '-'
      assign parts = formatted_low | split: '-'
      assign prefix_part = parts[0] | append: '-'
      assign suffix_part = formatted_low | remove_first: parts[0] | remove_first: '-'
      capture stock_display_html
        echo '<span class="stock-prefix">' | append: prefix_part | append: '</span><span class="stock-suffix">' | append: suffix_part | append: '</span>'
      endcapture
    else
      capture stock_display_html
        echo '<span class="stock-prefix">' | append: formatted_low | append: '</span>'
      endcapture
    endif
  elsif stock_policy == 'continue'
    assign stock_status_class = "in-stock not-track-stock"
    assign formatted_untracked = untracked_text_setting
    if formatted_untracked contains '-'
      assign parts = formatted_untracked | split: '-'
      assign prefix_part = parts[0] | append: '-'
      assign suffix_part = formatted_untracked | remove_first: parts[0] | remove_first: '-'
      capture stock_display_html
        echo '<span class="stock-prefix">' | append: prefix_part | append: '</span><span class="stock-suffix">' | append: suffix_part | append: '</span>'
      endcapture
    else
      capture stock_display_html
        echo '<span class="stock-prefix">' | append: formatted_untracked | append: '</span>'
      endcapture
    endif
  else
    assign stock_status_class = "out-of-stock"
    capture stock_display_html
      echo '<span class="stock-prefix">' | append: out_text_setting | append: '</span>'
    endcapture
  endif
-%}

<style>
.productView-info {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1rem;
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.5;
}
.productView-info-name {
    font-weight: 600;
    color: rgba(var(--color-foreground), 0.9);
}
.productView-info-value {
    margin: 0;
    color: rgba(var(--color-foreground), 0.8);
}
.productView-info-value.stock-info-value {
    grid-column: 1 / -1;
    font-weight: 500;
    color: rgba(var(--color-foreground), 0.9);
}
.productView-info-value.stock-info-value .stock-suffix {
    color: rgba(var(--color-foreground), 0.9);
}
.productView-info-value.stock-info-value.in-stock .stock-prefix {
    color: {{ block.settings.in_stock_color | default: '#46952e' }};
}
.productView-info-value.stock-info-value.low-stock .stock-prefix {
    color: {{ block.settings.low_stock_color | default: '#46952e' }};
}
.productView-info-value.stock-info-value.out-of-stock .stock-prefix,
.productView-info-value.stock-info-value.out-of-stock {
    color: {{ block.settings.out_of_stock_color | default: '#d9534f' }};
}
</style>

<dl class="productView-info" {{ block.shopify_attributes }}>
    {% if block.settings.show_sku %}
        {% assign current_sku = variant.sku | default: product.sku %}
        {% if current_sku != blank or block.settings.show_sku %}
            <dt class="productView-info-name sku-label">{{ block.settings.sku_label | default: "SKU:" }}</dt>
            <dd class="productView-info-value" data-product-sku="">{{ current_sku }}</dd>
        {% endif %}
    {% endif %}

    {% if block.settings.show_availability %}
        <dd class="productView-info-value stock-info-value {{ stock_status_class }}"
            data-stock-threshold="{{ threshold }}"
            data-high-stock-text="{{ block.settings.high_stock_text | default: '5+ In Stock - Available for immediate despatch' | escape }}"
            data-low-stock-text="{{ low_text_setting | escape }}"
            data-untracked-stock-text="{{ untracked_text_setting | escape }}"
            data-out-of-stock-text="{{ block.settings.out_of_stock_text | default: 'Out of Stock' | escape }}">
            <span class="custom-product-stock" data-stock-left=""></span>
            <span class="custom-instock-text"></span>
            <span class="stock-text">{{ stock_display_html }}</span>
            <script type="application/json" class="product-variant-inventory-data">
              {
                {%- for v in product.variants -%}
                  "{{ v.id }}": {
                    "inventory_quantity": {{ v.inventory_quantity | default: 0 }},
                    "inventory_management": {{ v.inventory_management | json }},
                    "inventory_policy": {{ v.inventory_policy | json }},
                    "available": {{ v.available | json }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              }
            </script>
        </dd>
    {% endif %}

    {% if block.settings.gift_wrapping_text != blank %}
        <dt class="productView-info-name"><strong>{{ block.settings.gift_wrapping_label | default: "Gift wrapping:" }}</strong></dt>
        <dd class="productView-info-value">{{ block.settings.gift_wrapping_text }}</dd>
    {% endif %}

    {% if gender_value != blank %}
        <dt class="productView-info-name">{{ block.settings.gender_label | default: "Gender:" }}</dt>
        <dd class="productView-info-value">{{ gender_value }}</dd>
    {% endif %}
</dl>

<script>
  (function() {
    function updateBlockInfoVariant(event) {
      let variant = null;
      if (event && event.detail && event.detail.variant) {
        variant = event.detail.variant;
      } else if (event && event.data && event.data.variant) {
        variant = event.data.variant;
      }
      if (!variant) return;

      // Update SKU
      const skuElements = document.querySelectorAll('.productView-info [data-product-sku]');
      skuElements.forEach(el => {
        el.textContent = variant.sku || '';
      });

      // Update Stock Info
      const stockElements = document.querySelectorAll('.productView-info .stock-info-value');
      stockElements.forEach(el => {
        const threshold = parseInt(el.dataset.stockThreshold, 10) || 5;
        const highText = el.dataset.highStockText || '5+ In Stock - Available for immediate despatch';
        let lowText = el.dataset.lowStockText || '[qty] In Stock - Available for immediate despatch';
        const untrackedText = el.dataset.untrackedStockText || 'Available for despatch in 1 to 7 working days';
        const outText = el.dataset.outOfStockText || 'Out of Stock';

        let inventoryData = null;
        const jsonScript = el.querySelector('.product-variant-inventory-data');
        if (jsonScript) {
          try {
            const parsed = JSON.parse(jsonScript.textContent);
            if (variant.id && parsed[variant.id]) {
              inventoryData = parsed[variant.id];
            }
          } catch(e) {}
        }

        const management = inventoryData ? inventoryData.inventory_management : variant.inventory_management;
        const policy = inventoryData ? inventoryData.inventory_policy : variant.inventory_policy;
        const available = inventoryData ? inventoryData.available : variant.available;
        const qty = inventoryData ? inventoryData.inventory_quantity : (typeof variant.inventory_quantity === 'number' ? variant.inventory_quantity : null);

        const stockTextEl = el.querySelector('.stock-text') || el;
        el.classList.remove('in-stock', 'low-stock', 'out-of-stock', 'not-track-stock');

        function formatStockHtml(textStr) {
          if (textStr.includes('-')) {
            const hyphenIdx = textStr.indexOf('-');
            const prefixStr = textStr.substring(0, hyphenIdx + 1);
            const suffixStr = textStr.substring(hyphenIdx + 1);
            return `<span class="stock-prefix">${prefixStr}</span><span class="stock-suffix">${suffixStr}</span>`;
          }
          return `<span class="stock-prefix">${textStr}</span>`;
        }

        const isUntracked = !management || management === '' || management !== 'shopify';

        if (isUntracked) {
          // Untracked inventory item -> Always untracked lead time!
          el.classList.add('in-stock', 'not-track-stock');
          stockTextEl.innerHTML = formatStockHtml(untrackedText);
        } else if (!available) {
          if (policy === 'continue') {
            el.classList.add('in-stock', 'not-track-stock');
            stockTextEl.innerHTML = formatStockHtml(untrackedText);
          } else {
            el.classList.add('out-of-stock');
            stockTextEl.innerHTML = formatStockHtml(outText);
          }
        } else if (qty !== null && qty > threshold) {
          el.classList.add('in-stock');
          stockTextEl.innerHTML = formatStockHtml(highText.replace(/\[qty\]/g, qty));
        } else if (qty !== null && qty > 0) {
          el.classList.add('low-stock');
          let formattedLow = lowText;
          if (formattedLow.includes('[qty]')) {
            formattedLow = formattedLow.replace(/\[qty\]/g, qty);
          } else if (!formattedLow.includes('In Stock')) {
            formattedLow = `${qty} In Stock - ${formattedLow}`;
          }
          stockTextEl.innerHTML = formatStockHtml(formattedLow);
        } else if (policy === 'continue') {
          el.classList.add('in-stock', 'not-track-stock');
          stockTextEl.innerHTML = formatStockHtml(untrackedText);
        } else {
          el.classList.add('out-of-stock');
          stockTextEl.innerHTML = formatStockHtml(outText);
        }
      });
    }

    document.addEventListener('variant:change', updateBlockInfoVariant);
    document.addEventListener('product:variant-change', updateBlockInfoVariant);
    if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
      subscribe(PUB_SUB_EVENTS.variantChange, updateBlockInfoVariant);
    }
  })();
</script>

{% schema %}
{
  "name": "Product Block Info",
  "settings": [
    {
      "type": "header",
      "content": "SKU Settings"
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": true
    },
    {
      "type": "text",
      "id": "sku_label",
      "label": "SKU Label",
      "default": "SKU:"
    },
    {
      "type": "header",
      "content": "Stock / Availability Settings"
    },
    {
      "type": "checkbox",
      "id": "show_availability",
      "label": "Show Stock / Availability Status",
      "default": true
    },
    {
      "type": "number",
      "id": "stock_threshold",
      "label": "High stock threshold",
      "default": 5,
      "info": "If stock quantity > threshold, displays High Stock text (e.g. 5+ In Stock)"
    },
    {
      "type": "inline_richtext",
      "id": "high_stock_text",
      "label": "High Stock Text (Tracked & Stock > Threshold)",
      "default": "5+ In Stock - Available for immediate despatch"
    },
    {
      "type": "inline_richtext",
      "id": "untracked_stock_text",
      "label": "Untracked Stock Text (Item not tracked)",
      "default": "Available for despatch in 1 to 7 working days",
      "info": "Display text for items without inventory tracking or when continue selling is enabled"
    },
    {
      "type": "inline_richtext",
      "id": "low_stock_text",
      "label": "Low Stock Text (Stock <= Threshold)",
      "default": "[qty] In Stock - Available for immediate despatch",
      "info": "Use [qty] tag if you want to dynamically insert remaining stock quantity"
    },
    {
      "type": "inline_richtext",
      "id": "out_of_stock_text",
      "label": "Out of Stock Text",
      "default": "Out of Stock"
    },
    {
      "type": "color",
      "id": "in_stock_color",
      "label": "In-Stock Color",
      "default": "#46952e"
    },
    {
      "type": "color",
      "id": "low_stock_color",
      "label": "Low-Stock Color",
      "default": "#46952e"
    },
    {
      "type": "color",
      "id": "out_of_stock_color",
      "label": "Out of Stock Color",
      "default": "#d9534f"
    },
    {
      "type": "header",
      "content": "Gift Wrapping"
    },
    {
      "type": "inline_richtext",
      "id": "gift_wrapping_label",
      "label": "Gift Wrapping Label",
      "default": "Gift wrapping:"
    },
    {
      "type": "inline_richtext",
      "id": "gift_wrapping_text",
      "label": "Gift Wrapping Text",
      "default": "Options available in the basket",
      "info": "Leave blank to hide gift wrapping section"
    },
    {
      "type": "header",
      "content": "Gender / Metafield"
    },
    {
      "type": "text",
      "id": "gender_label",
      "label": "Gender Label",
      "default": "Gender:"
    },
    {
      "type": "text",
      "id": "gender_metafield_key",
      "label": "Metafield Key",
      "default": "custom.gender",
      "info": "Metafield key (e.g., custom.gender or gender). If value is empty, section will hide automatically."
    }
  ],
  "presets": [
    {
      "name": "Product Block Info",
      "category": "Custom"
    }
  ]
}
{% endschema %}
