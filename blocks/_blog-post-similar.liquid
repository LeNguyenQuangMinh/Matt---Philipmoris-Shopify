{% assign current_article = article %}
{% assign target_blog = blog %}
{% assign posts_to_show = block.settings.posts_to_show | default: 2 %}
{% assign excluded_tags_setting = block.settings.excluded_tags | default: 'all, blog, news, post, recipes, recipe, articles' | downcase %}
{% assign excluded_tag_list = excluded_tags_setting | split: ',' %}

{%- capture current_tags_clean -%}
  {%- for tag in current_article.tags -%}
    {%- assign tag_lower = tag | downcase | strip -%}
    {%- unless tag_lower contains 'author:' or tag_lower contains 'author-' -%}
      {{ tag_lower }}|||
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign current_tag_arr = current_tags_clean | split: '|||' -%}

{%- comment -%} Determine best tag for View More link {%- endcomment -%}
{%- assign target_tag = '' -%}
{%- for tag in current_tag_arr -%}
  {%- if tag != blank -%}
    {%- assign is_excluded = false -%}
    {%- for excl in excluded_tag_list -%}
      {%- assign excl_clean = excl | strip -%}
      {%- if excl_clean != blank and tag == excl_clean -%}
        {%- assign is_excluded = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- unless is_excluded -%}
      {%- assign target_tag = tag -%}
      {%- break -%}
    {%- endunless -%}
  {%- endif -%}
{%- endfor -%}

{%- if target_tag == blank and current_article.tags.size > 0 -%}
  {%- assign target_tag = current_article.tags.first -%}
{%- endif -%}

{%- if target_tag != blank -%}
  {%- assign tag_handle = target_tag | handle -%}
  {%- assign view_more_url = target_blog.url | append: '/tagged/' | append: tag_handle -%}
{%- else -%}
  {%- assign view_more_url = target_blog.url -%}
{%- endif -%}

{%- comment -%} Compute relevance score for each article {%- endcomment -%}
{%- assign max_score = 0 -%}
{%- capture scored_data -%}
  {%- for art in target_blog.articles -%}
    {%- if art.id == current_article.id -%}{%- continue -%}{%- endif -%}
    {%- assign score = 0 -%}
    {%- for a_tag in art.tags -%}
      {%- assign a_tag_lower = a_tag | downcase | strip -%}
      {%- for c_tag in current_tag_arr -%}
        {%- assign c_tag_clean = c_tag | strip -%}
        {%- if c_tag_clean != blank and a_tag_lower == c_tag_clean -%}
          {%- assign is_generic = false -%}
          {%- for excl in excluded_tag_list -%}
            {%- assign excl_clean = excl | strip -%}
            {%- if excl_clean != blank and a_tag_lower == excl_clean -%}
              {%- assign is_generic = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if is_generic -%}
            {%- assign score = score | plus: 1 -%}
          {%- else -%}
            {%- assign score = score | plus: 3 -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- if score > max_score -%}
      {%- assign max_score = score -%}
    {%- endif -%}
    [{{ art.id }}:{{ score }}]
  {%- endfor -%}
{%- endcapture -%}

{% capture meta_markup %}
{% endcapture %}

<div
  id="blog-post-similar-{{ block.id }}"
  class="blog-post-similar spacing-style{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  style="
    {%- if block.settings.columns_desktop != 2 and block.settings.columns_desktop != blank -%}
      --similar-cols-desktop: {{ block.settings.columns_desktop }};
    {%- endif -%}
    {%- if block.settings.columns_mobile != 1 and block.settings.columns_mobile != blank -%}
      --similar-cols-mobile: {{ block.settings.columns_mobile }};
    {%- endif -%}
    {%- if block.settings.grid_gap_desktop != 25 and block.settings.grid_gap_desktop != blank -%}
      --similar-gap-desktop: {{ block.settings.grid_gap_desktop }}px;
    {%- endif -%}
    {%- if block.settings.grid_gap_mobile != 20 and block.settings.grid_gap_mobile != blank -%}
      --similar-gap-mobile: {{ block.settings.grid_gap_mobile }}px;
    {%- endif -%}
    {%- if block.settings.title_size_desktop != 22 and block.settings.title_size_desktop != blank -%}
      --similar-title-size-desktop: {{ block.settings.title_size_desktop }}px;
    {%- endif -%}
    {%- if block.settings.title_size_mobile != 18 and block.settings.title_size_mobile != blank -%}
      --similar-title-size-mobile: {{ block.settings.title_size_mobile }}px;
    {%- endif -%}
    {%- if block.settings.title_color != '#7d4747' and block.settings.title_color != '#7D4747' and block.settings.title_color != blank -%}
      --similar-title-color: {{ block.settings.title_color }};
    {%- endif -%}
    {%- if block.settings.title_text_transform != 'none' and block.settings.title_text_transform != blank -%}
      --similar-title-text-transform: {{ block.settings.title_text_transform }};
    {%- endif -%}
    {%- if block.settings.view_more_size != 14 and block.settings.view_more_size != blank -%}
      --similar-view-more-size: {{ block.settings.view_more_size }}px;
    {%- endif -%}
    {%- if block.settings.view_more_color != '#7d4747' and block.settings.view_more_color != '#7D4747' and block.settings.view_more_color != blank -%}
      --similar-view-more-color: {{ block.settings.view_more_color }};
    {%- endif -%}
    {%- if block.settings.aspect_ratio != '16 / 10' and block.settings.aspect_ratio != blank -%}
      --similar-card-aspect-ratio: {{ block.settings.aspect_ratio }};
    {%- endif -%}
    {%- if block.settings.card_border_radius != 4 and block.settings.card_border_radius != blank -%}
      --similar-card-radius: {{ block.settings.card_border_radius }}px;
    {%- endif -%}
    {%- if block.settings.card_alignment != 'center' and block.settings.card_alignment != blank -%}
      --similar-card-align: {{ block.settings.card_alignment }};
    {%- endif -%}
    {%- if block.settings.card_title_size_desktop != 22 and block.settings.card_title_size_desktop != blank -%}
      --similar-card-title-size-desktop: {{ block.settings.card_title_size_desktop }}px;
    {%- endif -%}
    {%- if block.settings.card_title_size_mobile != 18 and block.settings.card_title_size_mobile != blank -%}
      --similar-card-title-size-mobile: {{ block.settings.card_title_size_mobile }}px;
    {%- endif -%}
    {%- if block.settings.card_title_color != '#7d4747' and block.settings.card_title_color != '#7D4747' and block.settings.card_title_color != blank -%}
      --similar-card-title-color: {{ block.settings.card_title_color }};
    {%- endif -%}
    {%- if block.settings.card_meta_size != 13 and block.settings.card_meta_size != blank -%}
      --similar-card-meta-size: {{ block.settings.card_meta_size }}px;
    {%- endif -%}
    {%- if block.settings.card_meta_color != '#666666' and block.settings.card_meta_color != blank -%}
      --similar-card-meta-color: {{ block.settings.card_meta_color }};
    {%- endif -%}
    {% render 'spacing-style', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  <div class="similar-posts__header flex items-center justify-between">
    <h3 class="similar-posts__title">{{ block.settings.heading | default: 'Similar Posts' }}</h3>
    {% if block.settings.show_view_more != false %}
      <a href="{{ view_more_url }}" class="similar-posts__view-more">
        {{ block.settings.view_more_text | default: 'View More' }}
      </a>
    {% endif %}
  </div>

  <div class="similar-posts__grid">
    {% assign count = 0 %}
    {% assign rendered_ids = '' %}

    {%- comment -%} 1. Render articles by highest relevance score down to 1 {%- endcomment -%}
    {%- if max_score > 0 -%}
      {%- for eval_score in (1..max_score) reversed -%}
        {%- if count >= posts_to_show -%}{%- break -%}{%- endif -%}
        {%- for art in target_blog.articles -%}
          {%- if art.id == current_article.id -%}{%- continue -%}{%- endif -%}
          {%- assign art_id_str = art.id | append: ',' -%}
          {%- if rendered_ids contains art_id_str -%}{%- continue -%}{%- endif -%}
          
          {%- assign search_token = '[' | append: art.id | append: ':' | append: eval_score | append: ']' -%}
          {%- if scored_data contains search_token -%}
            {%- assign rendered_ids = rendered_ids | append: art_id_str -%}
            
            <div class="similar-post-card">
              {% if art.image != blank %}
                <a href="{{ art.url }}" class="similar-post-card__media">
                  {{ art.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: art.title }}
                </a>
              {% endif %}
              <div class="similar-post-card__content">
                <h4 class="similar-post-card__title">
                  <a href="{{ art.url }}">{{ art.title }}</a>
                </h4>
                {%- if block.settings.show_author != false or block.settings.show_date != false -%}
                  <div class="similar-post-card__meta">
                    {%- if block.settings.show_author != false and art.author != blank -%}
                      <span>
                        {{ art.author }}
                      </span>
                    {%- endif -%}
                    {%- if block.settings.show_date != false -%}
                      <span>
                        on {{ art.published_at | date: "%-d/%-m/%Y" }}
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>

            {% assign count = count | plus: 1 %}
            {% if count >= posts_to_show %}{% break %}{% endif %}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} 2. Fallback: Fill remaining slots with newest other articles if needed {%- endcomment -%}
    {%- if count < posts_to_show -%}
      {%- for art in target_blog.articles -%}
        {%- if art.id == current_article.id -%}{%- continue -%}{%- endif -%}
        {%- assign art_id_str = art.id | append: ',' -%}
        {%- unless rendered_ids contains art_id_str -%}
          {%- assign rendered_ids = rendered_ids | append: art_id_str -%}
          <div class="similar-post-card">
            {% if art.image != blank %}
              <a href="{{ art.url }}" class="similar-post-card__media">
                {{ art.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: art.title }}
              </a>
            {% endif %}
            <div class="similar-post-card__content">
              <h4 class="similar-post-card__title">
                <a href="{{ art.url }}">{{ art.title }}</a>
              </h4>
              {%- if block.settings.show_author != false or block.settings.show_date != false -%}
                <div class="similar-post-card__meta">
                  {%- if block.settings.show_author != false and art.author != blank -%}
                    <span>
                      {{ art.author }}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.show_date != false -%}
                    <span>
                      on {{ art.published_at | date: "%-d/%-m/%Y" }}
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>

          {% assign count = count | plus: 1 %}
          {% if count >= posts_to_show %}{% break %}{% endif %}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
