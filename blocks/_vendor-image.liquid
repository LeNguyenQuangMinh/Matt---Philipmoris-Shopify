{%- liquid
  assign bl_stts = block.settings
  assign product_resource = bl_stts.product | default: closest.product | default: product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{%- capture vendor_image_content -%}
  <div class="product-vendor-image-wrapper">
    <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
    <div class="product-vendor-image-inner{% if bl_stts.enable_vendor_image == false %} opacity-70{% endif %}">
      {%- if bl_stts.enable_vendor_image -%}
        {%- liquid
          assign vendor_handle = product_resource.vendor | handle
          assign vendor_image_name_png = vendor_handle | append: '.png'
          assign vendor_image_name_jpg = vendor_handle | append: '.jpg'
          assign vendor_image_name_jpeg = vendor_handle | append: '.jpeg'
          assign vendor_image_name_webp = vendor_handle | append: '.webp'
          assign vendor_image_name_svg = vendor_handle | append: '.svg'
          
          assign vendor_image = blank
          if images[vendor_image_name_png] != blank
            assign vendor_image = images[vendor_image_name_png]
          elsif images[vendor_image_name_jpg] != blank
            assign vendor_image = images[vendor_image_name_jpg]
          elsif images[vendor_image_name_jpeg] != blank
            assign vendor_image = images[vendor_image_name_jpeg]
          elsif images[vendor_image_name_webp] != blank
            assign vendor_image = images[vendor_image_name_webp]
          elsif images[vendor_image_name_svg] != blank
            assign vendor_image = images[vendor_image_name_svg]
          endif

          if vendor_image == blank and bl_stts.custom_image != blank
            assign vendor_image = bl_stts.custom_image
          endif
        -%}
        {%- if vendor_image != blank -%}
          {%- if bl_stts.link_vendor -%}
            <a 
              href="{{ product_resource.vendor | url_for_vendor }}" 
              title="{{ product_resource.vendor | escape }}" 
              class="vendor-image-link inline-flex items-center" 
              {% if bl_stts.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
              style="max-width: {{ bl_stts.image_max_width }}px; max-height: {{ bl_stts.image_max_height }}px;"
            >
              <img 
                src="{{ vendor_image | image_url: width: 400 }}" 
                alt="{{ product_resource.vendor | escape }}" 
                loading="lazy" 
                class="vendor-image object-contain" 
                width="{{ vendor_image.width }}" 
                height="{{ vendor_image.height }}" 
                style="max-width: {{ bl_stts.image_max_width }}px; max-height: {{ bl_stts.image_max_height }}px; width: auto; height: auto;"
              >
            </a>
          {%- else -%}
            <div 
              class="vendor-image-holder inline-flex items-center" 
              style="max-width: {{ bl_stts.image_max_width }}px; max-height: {{ bl_stts.image_max_height }}px;"
            >
              <img 
                src="{{ vendor_image | image_url: width: 400 }}" 
                alt="{{ product_resource.vendor | escape }}" 
                loading="lazy" 
                class="vendor-image object-contain" 
                width="{{ vendor_image.width }}" 
                height="{{ vendor_image.height }}" 
                style="max-width: {{ bl_stts.image_max_width }}px; max-height: {{ bl_stts.image_max_height }}px; width: auto; height: auto;"
              >
            </div>
          {%- endif -%}
        {%- elsif bl_stts.show_vendor_name_fallback -%}
          {%- if bl_stts.link_vendor -%}
            {{ product_resource.vendor | link_to_vendor }}
          {%- else -%}
            <span>{{ product_resource.vendor }}</span>
          {%- endif -%}
        {%- endif -%}
      {%- else -%}
        {%- if bl_stts.link_vendor -%}
          {{ product_resource.vendor | link_to_vendor }}
        {%- else -%}
          <span>{{ product_resource.vendor }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
{%- endcapture -%}

{%- if product_resource and product_resource != empty -%}
  {% render 'text', fallback_text: vendor_image_content, block: block %}
{%- else -%}
  {%- assign placeholder = 'products.product.vendor' | t -%}
  {% render 'text', fallback_text: placeholder, block: block %}
{%- endif -%}

