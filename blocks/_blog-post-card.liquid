{%- liquid
  assign block_settings = block.settings

  if block_settings.layout_type == 'balance'
    assign index_modulo = index | modulo: 2

    if index_modulo == 0
      assign balance_class = 'balance-even'
    else
      assign balance_class = 'balance-odd'
    endif
  endif
-%}

{% capture image %}
  {% content_for 'block', id: 'image', type: '_blog-post-image', image: article.image %}
{% endcapture %}

{% capture title %}
  {% content_for 'block', id: 'heading', type: '_heading', text: article.title %}
{% endcapture %}

{% capture description %}
  {% content_for 'block', id: 'content', type: '_blog-post-description', article: article %}
{% endcapture %}

{% capture details %}
  {% content_for 'block', id: 'blog-post-details', type: '_blog-post-info-text', alignment: block_settings.alignment, article: article %}
{% endcapture %}

{% capture button %}
  {% content_for 'block', id: 'button', type: '_blog-post-button', link: article.url %}
{% endcapture %}

{% capture arttributes_content %}
  class="
    blog-post-card__content{% unless article.image %} not-has-image{% endunless %}
    layout-panel-flex
    layout-panel-flex--{{ block_settings.content_direction }}
    spacing-style
  "
  style="
    {% render 'layout-panel-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings, suffix: 'content' %}
  "
  {{ block.shopify_attributes }}
{% endcapture %}

<div
  class="
    blog-post-card {% if block_settings.layout_type == 'classic' and first == true %} grid{% else %} md:flex max-md:grid{% endif %}
    blog-post-card--{{ block_settings.layout_type }}
    {{ balance_class }}
  "
  style="
    --text-align: {{ block_settings.horizontal_alignment_flex_direction_column | replace: 'flex-end', 'right' | replace: 'flex-start', 'left' }};
    --blog-post-gap: {{ block_settings.blog_post_card_gap }}px;
    --blog-post-gap-mobile: {{ block_settings.blog_post_card_gap_mobile }}px;
  "
>
  {% case block_settings.layout_type %}
    {% when 'classic' %}
      {% if first == true %}
        <div {{arttributes_content}}>
          <a
            href="{{ article.url }}"
            class="decoration-none{% if first == true %} has-label flex flex-wrap items-center{% else %} block{% endif %}"
          >
            {% if first == true %}
              <span class="blog-post-card__content-label inline-block font-bold">{{ 'blogs.article.featured' | t }}</span>
            {% endif %}
            {{ title }}
          </a>

          {{ details }}
        </div>
        {%- if article.image -%}
          <div class="blog-post-card__image-container">
            <a href="{{ article.url }}">
              {{ image }}
            </a>
          </div>
        {%- endif -%}
        <div {{arttributes_content}}>
          {{ description }}
          {{ button }}
        </div>
      {% else %}
        {%- if article.image -%}
          <div class="blog-post-card__image-container">
            <a href="{{ article.url }}">
              {{ image }}
            </a>
          </div>
        {%- endif -%}
        <div {{arttributes_content}}>
          <a
            href="{{ article.url }}"
            class="decoration-none block"
          >
            {{ title }}
          </a>

          {{ description }}
          {{ details }}
          {{ button }}
        </div>
      {% endif %}
    {% when 'simple' %}
      {%- if article.image -%}
        <div {{arttributes_content}}>
          <a
            href="{{ article.url }}"
            class="decoration-none block"
          >
            {{ title }}
          </a>

          {{ details }}
        </div>
        <div class="blog-post-card__image-container">
          <a href="{{ article.url }}">
            {{ image }}
          </a>
        </div>
        <div {{arttributes_content}}>
          {{ description }}
          {{ button }}
        </div>
      {%- else -%}
        <div {{arttributes_content}}>
          <a
            href="{{ article.url }}"
            class="decoration-none block"
          >
            {{ title }}
          </a>

          {{ details }}
          {{ description }}
          {{ button }}
        </div>
      {%- endif -%}
    {% when 'balance' %}
      {%- if article.image -%}
        <div class="blog-post-card__image-container">
          <a href="{{ article.url }}">
            {{ image }}
          </a>
        </div>
      {%- endif -%}
      <div {{arttributes_content}}>
        <a
          href="{{ article.url }}"
          class="decoration-none block"
        >
          {{ title }}
        </a>

        {{ details }}
        {{ description }}
        {{ button }}
      </div>
    {% when 'custom' %}
      <div {{arttributes_content}}>
        <a
          href="{{ article.url }}"
          class="decoration-none block"
        >
          {{ title }}
        </a>

        {{ details }}

        {%- if block_settings.show_tags and article.tags.size > 0 -%}
          {%- if block_settings.tags_custom_padding_button -%}
            {%- assign tags_btn_padding_block = block_settings.tags_button_padding_block | times: 0.1 | append: 'rem' -%}
            {%- assign tags_btn_padding_inline = block_settings.tags_button_padding_inline | times: 0.1 | append: 'rem' -%}
            {%- assign tags_btn_padding_style = 'padding: ' | append: tags_btn_padding_block | append: ' ' | append: tags_btn_padding_inline | append: ' !important;' -%}
          {%- else -%}
            {%- assign tags_btn_padding_style = nil -%}
          {%- endif -%}

          <div class="blog-post-card__tags flex flex-wrap items-center justify-center gap-xs">
            {%- for tag in article.tags -%}
              {%- assign tag_handle = tag | handleize -%}
              {%- assign tag_url = blog.url | append: '/tagged/' | append: tag_handle -%}
              {% render 'button',
                link: tag_url,
                label: tag,
                style_class: block_settings.tags_style_class,
                button_style: block_settings.tags_button_style,
                button_border_width: block_settings.tags_button_border_width,
                button_border_radius: block_settings.tags_button_border_radius,
                button_type_font: block_settings.tags_button_type_font,
                button_type_size: block_settings.tags_button_type_size,
                button_type_line_height: block_settings.tags_button_type_line_height,
                button_type_letter_spacing: block_settings.tags_button_type_letter_spacing,
                button_font_weight: block_settings.tags_button_font_weight,
                button_text_case: block_settings.tags_button_text_case,
                button_type_alignment: block_settings.tags_button_type_alignment,
                buttons_shadow_horizontal_offset: block_settings.tags_buttons_shadow_horizontal_offset,
                buttons_shadow_vertical_offset: block_settings.tags_buttons_shadow_vertical_offset,
                buttons_shadow_blur: block_settings.tags_buttons_shadow_blur,
                style: tags_btn_padding_style
              %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if article.image -%}
        <div class="blog-post-card__image-container">
          <a href="{{ article.url }}">
            {{ image }}
          </a>
        </div>
      {%- endif -%}

      {%- if description != blank or button != blank -%}
        <div {{arttributes_content}}>
          {{ description }}
          {{ button }}
        </div>
      {%- endif -%}
  {% endcase %}
</div>

<div class="section-global__blocks">
  {%- content_for 'blocks' -%}
</div>

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "classic",
          "label": "t:options.classic"  
        },
        {
          "value": "simple",
          "label": "t:options.simple"
        },
        {
          "value": "balance",
          "label": "t:options.balance"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "classic"
    },
    {
      "type": "range",
      "id": "blog_post_card_gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "blog_post_card_gap_mobile",
      "label": "t:settings.mobile_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "t:content.content_layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.content_direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ block.settings.content_direction != 'column' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type":  "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start-content",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end-content",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start-content",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end-content",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Tags",
      "visible_if": "{{ block.settings.layout_type == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:settings.show_tags",
      "default": true,
      "visible_if": "{{ block.settings.layout_type == 'custom' }}"
    },
    {
      "type": "select",
      "id": "tags_style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "link",
          "label": "t:options.link"
        }
      ],
      "default": "button-secondary",
      "visible_if": "{{ block.settings.layout_type == 'custom' and block.settings.show_tags }}"
    },
    {
      "type": "select",
      "id": "tags_button_style",
      "label": "t:settings.type",
      "visible_if": "{{ block.settings.layout_type == 'custom' and block.settings.show_tags and block.settings.tags_style_class != 'link' }}",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "outline",
          "label": "t:options.outline"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "tags_button_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.border_width",
      "default": 1,
      "visible_if": "{{ block.settings.layout_type == 'custom' and block.settings.show_tags and block.settings.tags_button_style == 'custom' and block.settings.tags_style_class != 'link' }}"
    },
    {
      "type": "range",
      "id": "tags_button_border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.border_radius",
      "default": 4,
      "visible_if": "{{ block.settings.layout_type == 'custom' and block.settings.show_tags and block.settings.tags_button_style == 'custom' and block.settings.tags_style_class != 'link' }}"
    },
    {
      "type": "select",
      "id": "tags_button_type_font",
      "label": "t:settings.font",
      "visible_if": "{{ block.settings.layout_type == 'custom' and block.settings.show_tags and block.settings.tags_button_style == 'custom' and block.settings.tags_style_class != 'link' }}",
      "options": [
        {
          "value": "var(--font-body--family)",
          "label": "t:options.body"
        },
        {
          "value": "var(--font-subheading--family)",
          "label": "t:options.subheading"
        },
        {
          "value": "var(--font-heading--family)",
          "label": "t:options.heading"
        }
      ],
      "default": "var(--font-body--family)"
    },
    {
      "type": "select",
      "id": "tags_button_type_size",
      "label": "t:settings.size",
      "visible_if": "{{ block.settings.layout_type == 'custom' and block.settings.show_tags and block.settings.tags_button_style == 'custom' and block.settings.tags_style_class != 'link' }}",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "1.0rem",
          "label": "10px"
        },
        {
          "value": "1.2rem",
          "label": "12px"
        },
        {
          "value": "1.4rem",
          "label": "14px"
        },
        {
          "value": "1.5rem",
          "label": "15px"
        },
        {
          "value": "1.6rem",
          "label": "16px"
        },
        {
          "value": "1.8rem",
          "label": "18px"
        },
        {
          "value": "2.0rem",
          "label": "20px"
        },
        {
          "value": "2.2rem",
          "label": "22px"
        },
        {
          "value": "2.4rem",
          "label": "24px"
        },
        {
          "value": "2.6rem",
          "label": "26px"
        },
        {
          "value": "2.8rem",
          "label": "28px"
        },
        {
          "value": "3.2rem",
          "label": "32px"
        }
      ],
      "default": "1.5rem"
    },
    {
      "type": "select",
      "id": "tags_button_type_line_height",
      "label": "t:settings.line_height",
      "options": [
        {
          "value": "tight",
          "label": "t:options.tight"
        },
        {
          "value": "normal",
          "label": "t:options.normal"
        },
        {
          "value": "loose",
          "label": "t:options.loose"
        }
      ],
      "default": "normal",
      "visible_if": "{{ block.settings.layout_type == 'custom' and block.settings.show_tags and block.settings.tags_button_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "tags_button_type_letter_spacing",
      "label": "t:settings.letter_spacing",
      "step": 0.1,
      "min": 0,
      "max": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.layout_type == 'custom' and block.settings.show_tags and block.settings.tags_button_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "tags_button_font_weight",
      "label": "t:settings.button_text_weight",
      "visible_if": "{{ block.settings.layout_type == 'custom' and block.settings.show_tags and block.settings.tags_button_style == 'custom' and block.settings.tags_style_class != 'link' }}",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
