      "label": "Custom padding button",
      "default": false,
      "visible_if": "{{ block.settings.layout_type == 'custom' and block.settings.show_tags }}"
    },
    {
      "type": "range",
      "id": "tags_button_padding_block",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 7,
