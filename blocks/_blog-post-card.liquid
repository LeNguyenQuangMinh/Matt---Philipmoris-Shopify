    },
    {
      "type": "range",
      "id": "tags_buttons_shadow_blur",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "t:settings.shadow_blur",
      "default": 0,
      "visible_if": "{{ block.settings.layout_type == 'custom' and block.settings.show_tags and block.settings.tags_button_style == 'custom' and block.settings.tags_style_class != 'link' }}"
