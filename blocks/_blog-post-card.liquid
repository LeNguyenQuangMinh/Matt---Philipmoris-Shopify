    },
    {
      "type": "range",
      "id": "tags_buttons_shadow_vertical_offset",
      "min": -12,
      "max": 12,
      "step": 1,
      "unit": "px",
      "label": "t:settings.shadow_vertical_offset",
      "default": 0,
