<div
  id="{{ b_id }}"
  class="blog-post-content rte spacing-style size-style"
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  <rte-formatter>
    {{ article.content }}
  </rte-formatter>
</div>

<script>
  (function() {
    function initBlogPostShare(container) {
      const scope = container || document;
      const shareContainers = scope.querySelectorAll('.blogPost_share');
      if (!shareContainers.length) return;

      const shareUrl = encodeURIComponent(window.location.href);
      const shareTitle = encodeURIComponent(document.title);

      const shareHtml = `
        <div class="product-share-list-block flex flex-wrap flex-column">
          <ul class="list-unstyled list-social list-social--default flex flex-wrap" role="list">
            <li class="list-social__item">
              <a class="list-social__link link icon--facebook" title="Facebook" href="https://facebook.com/sharer/sharer.php?u=${shareUrl}" target="_blank" rel="noopener" aria-label="Facebook">
                <span class="svg-wrapper">
                  <svg viewBox="0 0 320 512" aria-hidden="true" focusable="false" role="presentation">
                    <path fill="currentColor" d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z" />
                  </svg>
                </span>
                <span class="visually-hidden">Facebook</span>
              </a>
            </li>
            <li class="list-social__item">
              <a class="list-social__link link icon--email" title="Email" href="mailto:?subject=${shareTitle}&amp;body=${shareUrl}" target="_self" rel="noopener" aria-label="Email">
                <span class="svg-wrapper">
                  <svg viewBox="0 0 28 28" aria-hidden="true" focusable="false" role="presentation">
                    <path fill="currentColor" d="M0 23.5v-12.406q0.688 0.766 1.578 1.359 5.656 3.844 7.766 5.391 0.891 0.656 1.445 1.023t1.477 0.75 1.719 0.383h0.031q0.797 0 1.719-0.383t1.477-0.75 1.445-1.023q2.656-1.922 7.781-5.391 0.891-0.609 1.563-1.359v12.406q0 1.031-0.734 1.766t-1.766 0.734h-23q-1.031 0-1.766-0.734t-0.734-1.766zM0 6.844q0-1.219 0.648-2.031t1.852-0.812h23q1.016 0 1.758 0.734t0.742 1.766q0 1.234-0.766 2.359t-1.906 1.922q-5.875 4.078-7.313 5.078-0.156 0.109-0.664 0.477t-0.844 0.594-0.812 0.508-0.898 0.422-0.781 0.141h-0.031q-0.359 0-0.781-0.141t-0.898-0.422-0.812-0.508-0.844-0.594-0.664-0.477q-1.422-1-4.094-2.852t-3.203-2.227q-0.969-0.656-1.828-1.805t-0.859-2.133z"/>
                  </svg>
                </span>
                <span class="visually-hidden">Email</span>
              </a>
            </li>
            <li class="list-social__item">
              <a class="list-social__link link icon--print" title="Print" href="javascript:void(0)" onclick="window.print();return false;" role="button" aria-label="Print">
                <span class="svg-wrapper">
                  <svg viewBox="0 0 26 28" aria-hidden="true" focusable="false" role="presentation">
                    <path fill="currentColor" d="M0 21.5v-6.5q0-1.234 0.883-2.117t2.117-0.883h1v-8.5q0-0.625 0.438-1.062t1.062-0.438h10.5q0.625 0 1.375 0.313t1.188 0.75l2.375 2.375q0.438 0.438 0.75 1.188t0.313 1.375v4h1q1.234 0 2.117 0.883t0.883 2.117v6.5q0 0.203-0.148 0.352t-0.352 0.148h-3.5v2.5q0 0.625-0.438 1.062t-1.062 0.438h-15q-0.625 0-1.062-0.438t-0.438-1.062v-2.5h-3.5q-0.203 0-0.352-0.148t-0.148-0.352zM6 24h14v-4h-14v4zM6 14h14v-6h-2.5q-0.625 0-1.062-0.438t-0.438-1.062v-2.5h-10v10zM22 15q0 0.406 0.297 0.703t0.703 0.297 0.703-0.297 0.297-0.703-0.297-0.703-0.703-0.297-0.703 0.297-0.297 0.703z"/>
                  </svg>
                </span>
                <span class="visually-hidden">Print</span>
              </a>
            </li>
            <li class="list-social__item">
              <a class="list-social__link link icon--x" href="https://x.com/intent/tweet/?text=${shareTitle}&amp;url=${shareUrl}" target="_blank" rel="noopener" title="X" aria-label="X">
                <span class="svg-wrapper">
                  <svg viewBox="0 0 1200 1227" aria-hidden="true" focusable="false" role="presentation">
                    <path fill="currentColor" d="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z" />
                  </svg>
                </span>
                <span class="visually-hidden">X</span>
              </a>
            </li>
          </ul>
        </div>
      `;

      shareContainers.forEach(function(el) {
        el.innerHTML = shareHtml;
      });
    }

    function customAnimate(section) {
      if (!section || section.classList.contains('animate-loaded')) return;
      section.classList.add('animate-loaded', 'animated');
    }

    function initSectionLoad(container) {
      const scope = container || document;
      initBlogPostShare(scope);

      const sections = scope.querySelectorAll('[data-section-load]');
      if (!sections.length) return;

      if (!('IntersectionObserver' in window)) {
        sections.forEach(function(section) {
          if (section.getAttribute('data-section-load') === 'animation') {
            customAnimate(section);
          }
        });
        return;
      }

      const options = {
        threshold: 0.05
      };

      const observer = new IntersectionObserver(function(entries, obs) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            const section = entry.target;
            const sectionType = section.getAttribute('data-section-load');
            if (sectionType === 'animation') {
              customAnimate(section);
            }
            obs.unobserve(section);
          }
        });
      }, options);

      sections.forEach(function(section) {
        if (!section.classList.contains('animate-loaded')) {
          observer.observe(section);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initSectionLoad(document.getElementById('{{ b_id }}'));
      });
    } else {
      initSectionLoad(document.getElementById('{{ b_id }}'));
    }

    document.addEventListener('shopify:section:load', function(e) {
      initSectionLoad(e.target);
    });
  })();
</script>

