{%- assign target_url = override_url | default: link.url -%}
<span
  class="text{% if link.child_active %} header__active-menu-item{% endif %}{% if target_url != blank %} header__menu-parent-link{% endif %}"
  {% if target_url != blank %}
    data-href="{{ target_url }}"
  {% else %}
    aria-disabled="true"
  {% endif %}
>
  {{- link.title | escape -}}
</span>
