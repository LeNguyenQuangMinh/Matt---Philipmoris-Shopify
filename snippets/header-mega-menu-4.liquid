{% comment %}
  Renders a megamenu for the header.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

{%- liquid
  assign bl_stts = block.settings
  assign divider = bl_stts.divider

  assign section_fetch = section_fetch | default: false
  if section.index == nil
    assign section_fetch = true
  endif

  assign text_align = bl_stts.text_alignment | default: 'center'
  assign align_items = 'center'
  if text_align == 'left'
    assign align_items = 'flex-start'
  elsif text_align == 'right'
    assign align_items = 'flex-end'
  endif

  assign aspect_ratio_padding = '100%'
  if bl_stts.image_aspect_ratio == 'portrait'
    assign aspect_ratio_padding = '133.33%'
  elsif bl_stts.image_aspect_ratio == 'landscape'
    assign aspect_ratio_padding = '75%'
  endif
-%}

{%- unless section_fetch -%}
  <div
    id="MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }}"
    class="list-menu--wrapper"
    tabindex="-1"
    style="--columns-count: {{ bl_stts.grid }}; --gap-x: 1.6rem; --gap-y: 1.6rem"
  ></div>
{%- else -%}
  <div
    id="MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }}"
    class="list-menu--wrapper mega-menu--4 {% if bl_stts.inherit_color_scheme == false %} color-{{ bl_stts.color_scheme }}{% endif %} {% if divider %} border-b{% endif %}"
    tabindex="-1"
    style="--columns-count: {{ bl_stts.grid }}; --gap-x: {{ bl_stts.column_gap | default: 20 }}px; --gap-y: {{ bl_stts.row_gap | default: 30 }}px;"
  >
  <style>
    #MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }} .mega-menu-4-top {
      margin-bottom: 3.6rem;
    }
    #MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }} .mega-menu__list {
      display: grid;
      gap: {{ bl_stts.row_gap | default: 30 }}px {{ bl_stts.column_gap | default: 20 }}px;
      grid-template-columns: repeat({{ bl_stts.grid }}, minmax(0, 1fr));
    }
    #MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }} .mega-menu__column {
      display: flex;
      flex-direction: column;
      align-items: {{ align_items }};
      text-align: {{ text_align }};
    }
    #MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }} .mega-menu__link--level-2 {
      font-size: {{ bl_stts.level_2_font_size | default: '1.3rem' }};
      font-weight: {{ bl_stts.level_2_font_weight | default: '600' }};
      text-transform: {{ bl_stts.level_2_case | default: 'uppercase' }};
      text-decoration: {% if bl_stts.level_2_underline != false %}underline{% else %}none{% endif %};
      text-underline-offset: 4px;
      {% if bl_stts.level_2_color != blank %}color: {{ bl_stts.level_2_color }};{% endif %}
      text-align: {{ text_align }};
      padding: 0;
      line-height: 1.3;
    }
    #MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }} .mega-menu__list--level-3 {
      display: flex;
      flex-direction: column;
      gap: {{ bl_stts.level_3_gap | default: 8 }}px;
      margin: 0;
      padding: 0;
      align-items: {{ align_items }};
      text-align: {{ text_align }};
    }
    #MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }} .mega-menu__link--level-3 {
      font-size: {{ bl_stts.level_3_font_size | default: '1.3rem' }};
      font-weight: {{ bl_stts.level_3_font_weight | default: '400' }};
      text-transform: {{ bl_stts.level_3_case | default: 'none' }};
      {% if bl_stts.level_3_color != blank %}color: {{ bl_stts.level_3_color }};{% else %}color: rgba(var(--color-foreground), 0.8);{% endif %}
      text-align: {{ text_align }};
      padding: 0;
      line-height: 1.4;
    }
    @media screen and (max-width: 989px) {
      #MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }} .mega-menu__list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem 1rem;
      }
      #MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }} .mega-menu-4-top {
        text-align: left;
        margin-bottom: 1.5rem;
      }
      #MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }} .mega-menu-4-top a {
        text-decoration: underline;
        text-underline-offset: 0.3rem;
        font-size: 1.3rem;
      }
      #MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }} .mega-menu__link--level-2 {
        font-size: 1.1rem;
        text-align: center;
        text-decoration: none;
        line-height: 1.3;
        letter-spacing: 0;
      }
      #MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }} .mega-menu__column {
        gap: 0.8rem;
        align-items: center;
        text-align: center;
      }
      #MegaMenu-Content-{{ section.id }}-{{ forloopIndex }}-{{ block_id }} {
        padding: 0 0 2rem 0;
      }
    }

    .header__mega-submenu--style-4 .mega-menu__link--level-2 {
      margin-bottom: 0.5rem;
      margin-top: 1rem;
    }
    .header__mega-submenu--style-4 .mega-menu__list--level-3 li {
      margin-bottom: 0;
    }
  </style>
  {% if link.links.size > 0 %}
    <div class="mega-menu__container page-width page-width--{{ bl_stts.width }}{% if bl_stts.width == 'custom' or bl_stts.width == 'page-width' %} mega-menu__container--custom-width{% endif %}"{% if bl_stts.width == 'custom' %} style="width: min(100vw, {{ bl_stts.custom_width }}px); max-width: 100%; margin: 0 auto;"{% endif %}>
      
      {%- if bl_stts.top_link_label != blank -%}
      <div class="mega-menu-4-top center uppercase">
        <a
          {% if bl_stts.top_link_url == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ bl_stts.top_link_url | default: '#' }}"
          {% endif %}
          class="link link--hover-underline"
          style="--button-font-size-link: 1.6rem;"
        >
          {{ bl_stts.top_link_label }}
        </a>
      </div>
      {%- endif -%}

      <ul
        class="mega-menu__list header__mega-submenu header__mega-submenu--style-4 grid-layout lg:grid-layout--{{ bl_stts.grid }}"
        role="list"
      >
        {%- for childlink in link.links -%}
          {%- assign image = blank -%}
          
          {%- assign lv1_handle = link.title | replace: '&', 'and' | handleize -%}
          {%- assign lv2_handle = childlink.title | replace: '&', 'and' | handleize -%}
          {%- assign image_name_jpg = lv1_handle | append: '-' | append: lv2_handle | append: '.jpg' -%}
          {%- assign image_name_png = lv1_handle | append: '-' | append: lv2_handle | append: '.png' -%}
          {%- assign image_name_webp = lv1_handle | append: '-' | append: lv2_handle | append: '.webp' -%}
          
          {%- assign custom_image = images[image_name_jpg] -%}
          {%- if custom_image == blank -%}
            {%- assign custom_image = images[image_name_png] -%}
          {%- endif -%}
          {%- if custom_image == blank -%}
            {%- assign custom_image = images[image_name_webp] -%}
          {%- endif -%}

          {%- if custom_image != blank -%}
            {%- assign image = custom_image -%}
          {%- elsif childlink.type == 'collection_link' and childlink.object.image != blank -%}
            {%- assign image = childlink.object.image -%}
          {%- endif -%}

          <li class="mega-menu__column">
            {%- if image != blank -%}
              <a href="{{ childlink.url }}" class="media media--transparent block mb-2 w-full" style="padding-bottom: {{ aspect_ratio_padding }}; position: relative; display: block; overflow: hidden; border-radius: {{ bl_stts.image_corner_radius | default: 0 }}px;">
                <img src="{{ image | image_url: width: 300 }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt | escape }}" class="motion-reduce" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;">
              </a>
            {%- endif -%}
            
            <a href="{{ childlink.url }}" class="header__menu-item mega-menu__link mega-menu__link--level-2 link link--hover-underline">
              {{ childlink.title | escape }}
            </a>
            
            {%- if childlink.links != blank -%}
              <ul class="mega-menu__list--level-3 list-unstyled max-md:hidden" role="list">
                {%- for grandchildlink in childlink.links -%}
                  <li>
                    <a href="{{ grandchildlink.url }}" class="header__menu-item mega-menu__link mega-menu__link--level-3 link link--hover-underline">
                      {{ grandchildlink.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

    </div>
  {% endif %}
  </div>
{%- endunless -%}
