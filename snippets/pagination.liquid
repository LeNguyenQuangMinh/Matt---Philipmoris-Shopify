{% doc %}
  Display pagination for a list of products or articles.

  @param {object} paginate - Shopify paginate object
  @param {object} section - section object with settings
  @param {object} settings - optional settings override
  @param {string} suffix - optional suffix for spacing
  @param {string} anchor - optional anchor url
{% enddoc %}

{% liquid
  assign sec_stts = settings | default: section.settings
  assign pagination_type = sec_stts.pagination_type
%}

{%- if paginate.parts.size > 0 -%}
  <div
    class="
      pagination-wrapper
      spacing-style
      {{ pagination_type }}
    "
    style="
      {% render 'spacing-style', settings: sec_stts, suffix: suffix %}
      {% render 'border-override', settings: sec_stts %}
      --pagination-alignment: {{ sec_stts.pagination_alignment | default: 'center' }};
    "
  >
    <nav
      class="pagination{% if pagination_type == 'infinite' or pagination_type == 'viewmore' %} hidden{% endif %}"
      role="navigation"
      aria-label="{{ 'content.pagination.label' | t | default: 'Pagination' }}"
    >
      <div class="pagination__container">
        <div class="pagination__prev-wrap">
          {%- if paginate.previous -%}
            <a
              href="{{ paginate.previous.url }}{{ anchor }}"
              class="pagination__item pagination__item--prev pagination__nav-link link motion-reduce"
              aria-label="{{ 'content.pagination.previous' | t | default: 'Previous' }}"
            >
              <svg class="pagination__nav-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
              <span class="pagination__nav-text">{{ 'content.pagination.previous' | t | default: 'Previous' }}</span>
            </a>
          {%- else -%}
            <span class="pagination__nav-link pagination__nav-link--disabled is-hidden" aria-hidden="true">
              <svg class="pagination__nav-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
              <span class="pagination__nav-text">{{ 'content.pagination.previous' | t | default: 'Previous' }}</span>
            </span>
          {%- endif -%}
        </div>

        <ul class="pagination__list list-unstyled" role="list">
          {%- for part in paginate.parts -%}
            <li class="pagination__list-item">
              {%- if part.is_link -%}
                <a
                  href="{{ part.url }}{{ anchor }}"
                  class="pagination__item pagination__item--link link"
                  aria-label="{{ 'content.pagination.page' | t: number: part.title | default: part.title }}"
                >
                  {{- part.title -}}
                </a>
              {%- else -%}
                {%- if part.title == paginate.current_page -%}
                  <span
                    class="pagination__item pagination__item--current"
                    aria-current="page"
                    aria-label="{{ 'content.pagination.page' | t: number: part.title | default: part.title }}"
                  >
                    {{- part.title -}}
                  </span>
                {%- else -%}
                  <span class="pagination__item pagination__item--gap">{{ part.title }}</span>
                {%- endif -%}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        <div class="pagination__next-wrap">
          {%- if paginate.next -%}
            <a
              href="{{ paginate.next.url }}{{ anchor }}"
              class="pagination__item pagination__item--next pagination__nav-link link motion-reduce"
              aria-label="{{ 'content.pagination.next' | t | default: 'Next' }}"
            >
              <span class="pagination__nav-text">{{ 'content.pagination.next' | t | default: 'Next' }}</span>
              <svg class="pagination__nav-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </a>
          {%- else -%}
            <span class="pagination__nav-link pagination__nav-link--disabled is-hidden" aria-hidden="true">
              <span class="pagination__nav-text">{{ 'content.pagination.next' | t | default: 'Next' }}</span>
              <svg class="pagination__nav-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 18l6-6-6-6"/>
              </svg>
            </span>
          {%- endif -%}
        </div>
      </div>
    </nav>

    {% if sec_stts.pagination_type == 'infinite' or sec_stts.pagination_type == 'viewmore' %}
      <!-- Infinite Scrolling Button -->
      <infinite-scrolling class="infinite-scrolling-wrapper block center" data-pagination-type="{{ sec_stts.pagination_type }}">
        <div class="pagination-page-item pagination-page-total flex-center flex-wrap gap-2xs hidden">
          <span>{{ 'content.start_count' | t }}</span>
          <span data-total-start>{{ paginate.current_offset | plus: 1 }}</span>
          <span>-</span>
          {%- if paginate.next -%}
            <span data-total-end>{{ paginate.current_offset | plus: paginate.page_size }}</span>
          {%- else -%}
            <span data-total-end>{{ paginate.items }}</span>
          {%- endif -%}
          <span>{{ 'content.end_count' | t: count: paginate.items }}</span>
          {%- if paginate.next -%}
            {% liquid
              assign pg_current = paginate.current_offset | plus: paginate.page_size
              assign pg_total = paginate.items
              assign total_progress = pg_current | times: 100 | divided_by: pg_total | append: '%'
            %}
          {%- else -%}
            {%- assign total_progress = '100%' -%}
          {%- endif -%}
          <div class="progress-wrapper flex-center w-full">
            <div class="pagination-total-progress w-full overflow-hidden">
              <span style="width: {{ total_progress }}" class="pagination-total-item h-full block"></span>
            </div>
          </div>
        </div>

        <button
          type="button"
          class="button button--primary infinite-scrolling-btn"
          data-infinite-scrolling
          aria-label="{{ 'content.show_more' | t }}"
        >
          <span class="text">
            {%- if paginate.next -%}
              {{ 'content.show_more' | t }}
            {%- else -%}
              {{ 'content.no_more' | t }}
            {%- endif -%}
          </span>
          {% render 'loading-spinner' %}
        </button>
      </infinite-scrolling>
    {%- endif -%}
  </div>
{%- endif -%}
